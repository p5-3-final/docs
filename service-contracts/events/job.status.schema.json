{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vlm.example/contracts/events/job.status.schema.json",
  "title": "JobStatus",
  "description": "분석 상태와 별도 실행 집계 전체 스냅샷. sourceId 키, jobId별 sequence로 역순을 무시한다. 실행 종료는 적재 완료가 아니다.",
  "allOf": [
    {
      "$ref": "_envelope.schema.json"
    }
  ],
  "type": "object",
  "required": [
    "jobId",
    "sourceId",
    "ownerId",
    "status",
    "sequence",
    "execution",
    "issues",
    "failures"
  ],
  "properties": {
    "jobId": {
      "type": "string",
      "format": "uuid"
    },
    "sourceId": {
      "type": "string",
      "format": "uuid"
    },
    "ownerId": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "type": "string"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "succeeded",
        "failed",
        "pending",
        "retryPending",
        "running",
        "unknown",
        "progressPercent",
        "successPercent",
        "status",
        "terminal"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "succeeded": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "pending": {
          "type": "integer",
          "minimum": 0
        },
        "retryPending": {
          "type": "integer",
          "minimum": 0
        },
        "running": {
          "type": "integer",
          "minimum": 0
        },
        "unknown": {
          "type": "integer",
          "minimum": 0
        },
        "progressPercent": {
          "type": "integer",
          "minimum": 0
        },
        "successPercent": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "type": "string",
          "enum": [
            "PENDING",
            "RUNNING",
            "UNKNOWN",
            "SUCCEEDED",
            "PARTIAL_FAILED",
            "FAILED"
          ]
        },
        "terminal": {
          "type": "boolean"
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "chunkId",
          "executionId",
          "state",
          "attempt",
          "errorCode",
          "retryAt"
        ],
        "properties": {
          "chunkId": {
            "type": "string",
            "format": "uuid"
          },
          "executionId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "state": {
            "type": "string"
          },
          "attempt": {
            "type": "integer",
            "minimum": 0
          },
          "errorCode": {
            "type": [
              "string",
              "null"
            ]
          },
          "retryAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      }
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "chunkId",
          "executionId",
          "attempt",
          "status",
          "errorCode"
        ],
        "properties": {
          "chunkId": {
            "type": "string",
            "format": "uuid"
          },
          "executionId": {
            "type": "string",
            "format": "uuid"
          },
          "attempt": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "type": "string"
          },
          "errorCode": {
            "type": "string"
          }
        }
      }
    },
    "eventType": {
      "const": "job.status"
    },
    "schemaVersion": {
      "const": 1
    }
  },
  "examples": [
    {
      "jobId": "11111111-1111-4111-8111-111111111111",
      "sourceId": "22222222-2222-4222-8222-222222222222",
      "ownerId": "33333333-3333-4333-8333-333333333333",
      "status": "RUNNING",
      "sequence": 2,
      "execution": {
        "status": "SUCCEEDED",
        "terminal": true,
        "total": 2,
        "succeeded": 2,
        "failed": 0,
        "pending": 0,
        "retryPending": 0,
        "running": 0,
        "unknown": 0,
        "progressPercent": 100,
        "successPercent": 100
      },
      "issues": [],
      "failures": [],
      "eventId": "44444444-4444-4444-8444-444444444444",
      "eventType": "job.status",
      "schemaVersion": 1,
      "occurredAt": "2026-11-05T00:00:00Z"
    }
  ]
}
