{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vlm.example/contracts/events/track.manifest.schema.json",
  "title": "TrackManifest",
  "description": "Job 하나의 트랙 연결(경계 연결·Re-ID)이 끝났다. Job마다 한 번 발행한다(같은 Job이면 같은 eventId). pipeline-service가 완료 판정에 세고, analysis-api가 번역표로 최종 trackId를 정한다. 발행: track-stitcher. 소비: pipeline-service, analysis-api (SPEC-022 R-10~R-14)",
  "type": "object",
  "allOf": [
    {
      "$ref": "_envelope.schema.json"
    }
  ],
  "required": [
    "jobId",
    "normalizationId",
    "complete",
    "missingRanges",
    "chunkCount",
    "localTrackCount",
    "trackCount",
    "boundaryLinkCount",
    "reidLinkCount",
    "reidSkippedReason",
    "mappingKey",
    "stitchProfile",
    "embeddingModel"
  ],
  "properties": {
    "eventType": {
      "const": "track.manifest"
    },
    "schemaVersion": {
      "const": 1
    },
    "jobId": {
      "type": "string",
      "format": "uuid"
    },
    "normalizationId": {
      "type": "string",
      "format": "uuid"
    },
    "complete": {
      "type": "boolean",
      "description": "모든 청크의 chunk.boundary를 받아 소유 범위가 영상 전체를 덮었다. false면 대기 제한 시간이 지나 받은 청크만으로 끝낸 것이다"
    },
    "missingRanges": {
      "type": "array",
      "items": {
        "$ref": "chunk.requested.schema.json#/properties/ownedRange"
      },
      "description": "chunk.boundary를 받지 못한 시간 범위. complete면 빈 배열"
    },
    "chunkCount": {
      "type": "integer",
      "minimum": 0,
      "description": "번역표에 넣은 청크 수"
    },
    "localTrackCount": {
      "type": "integer",
      "minimum": 0
    },
    "trackCount": {
      "type": "integer",
      "minimum": 0,
      "description": "최종 트랙 수"
    },
    "boundaryLinkCount": {
      "type": "integer",
      "minimum": 0
    },
    "reidLinkCount": {
      "type": "integer",
      "minimum": 0
    },
    "reidSkippedReason": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "embedding_model_mismatch",
        "disabled"
      ],
      "description": "Re-ID를 하지 않은 이유. 했으면 null. 크롭 벡터가 없는 청크만 빠진 것은 이유가 아니다(그 청크 트랙만 Re-ID에서 빠진다)"
    },
    "mappingKey": {
      "type": "string",
      "pattern": "^sources/[0-9a-f-]{36}/jobs/[0-9a-f-]{36}/tracks/mapping[.]json$",
      "description": "번역표(tracks/v1/track-mapping.schema.json)"
    },
    "stitchProfile": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,99}$"
    },
    "embeddingModel": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[^:\\s]+:[^:\\s]+:[^:\\s]+:[^:\\s]+$"
    }
  },
  "examples": [
    {
      "eventId": "0192f100-0000-5000-8000-0000000000d1",
      "eventType": "track.manifest",
      "schemaVersion": 1,
      "occurredAt": "2026-11-06T09:03:00Z",
      "sourceId": "0192f0d2-1a2b-7c3d-8e4f-5a6b7c8d9e0f",
      "ownerId": "0192f0c4-6d1e-7a3b-9c2d-1e2f3a4b5c6d",
      "jobId": "0192f100-0000-7000-8000-000000000001",
      "normalizationId": "0192f100-0000-7000-8000-000000000004",
      "complete": true,
      "missingRanges": [],
      "chunkCount": 5,
      "localTrackCount": 61,
      "trackCount": 38,
      "boundaryLinkCount": 9,
      "reidLinkCount": 14,
      "reidSkippedReason": null,
      "mappingKey": "sources/0192f0d2-1a2b-7c3d-8e4f-5a6b7c8d9e0f/jobs/0192f100-0000-7000-8000-000000000001/tracks/mapping.json",
      "stitchProfile": "local-1",
      "embeddingModel": "open_clip:MobileCLIP2-S0:dfndr2b:mean-4"
    }
  ]
}
