{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vlm.example/contracts/events/segment.ready.schema.json",
  "title": "SegmentReady",
  "description": "청크의 검색 경로 입력이 준비됐다. 구간마다 블러 처리한 프레임 4장과 트랙 대표 크롭을 S3의 실행 폴더 blurred/ 아래에 저장한 뒤 실행마다 한 번 발행한다(재시도 시 같은 eventId). 구간은 소유 범위 안에서 시작하는 10초 창·5초 간격이다. 구간과 크롭이 없어도 발행한다. 발행: chunk-processor. 소비: frame-encoder (SPEC-019, docs overview 분석 처리 흐름 5단계)",
  "type": "object",
  "allOf": [
    {
      "$ref": "_envelope.schema.json"
    }
  ],
  "required": ["jobId", "chunkId", "executionId", "normalizationId", "segments", "crops"],
  "properties": {
    "eventType": {
      "const": "segment.ready"
    },
    "schemaVersion": {
      "const": 1
    },
    "jobType": {
      "type": "string",
      "enum": [
        "FULL",
        "REANALYZE",
        "REEMBED",
        "STREAM"
      ],
      "description": "Job 유형(v5.1, ADR-0015). 없으면 FULL. STREAM이면 실시간 창(stream-ingestor)이고 track-stitcher·pipeline-service는 건너뛴다."
    },
    "jobId": {
      "type": "string",
      "format": "uuid"
    },
    "chunkId": {
      "type": "string",
      "format": "uuid"
    },
    "executionId": {
      "type": "string",
      "format": "uuid"
    },
    "normalizationId": {
      "type": "string",
      "format": "uuid"
    },
    "segments": {
      "type": "array",
      "maxItems": 64,
      "description": "구간 목록. 시작 시각 순",
      "items": {
        "$ref": "#/$defs/segment"
      }
    },
    "crops": {
      "type": "array",
      "maxItems": 512,
      "description": "트랙 대표 크롭(트랙당 1~3장)",
      "items": {
        "$ref": "#/$defs/crop"
      }
    }
  },
  "$defs": {
    "imageKey": {
      "type": "string",
      "pattern": "^sources/[0-9a-f-]{36}/jobs/[0-9a-f-]{36}/chunks/[0-9a-f-]{36}/executions/[0-9a-f-]{36}/blurred/[^/?#]+\\.(jpg|jpeg|png|webp)$",
      "description": "블러 사본 경로. 이 메시지의 sourceId·jobId·chunkId·executionId 폴더의 blurred/ 아래여야 한다(ai-gateway가 블러 사본만 받는 규칙과 같다)."
    },
    "segment": {
      "type": "object",
      "required": ["segmentId", "startMs", "endMs", "static", "frames"],
      "additionalProperties": false,
      "properties": {
        "segmentId": {
          "type": "string",
          "format": "uuid",
          "description": "구간 ID. 정규화 결과와 시각으로 결정적으로 만든다."
        },
        "startMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "description": "정규화 영상 시작 기준 구간 시작(포함)"
        },
        "endMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "description": "구간 끝(제외)"
        },
        "static": {
          "type": "boolean",
          "description": "직전 구간과 거의 같은 정적 구간. 벡터는 그래도 만든다."
        },
        "frames": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "description": "구간 안 균등 간격 프레임 4장",
          "items": {
            "type": "object",
            "required": ["ptsMs", "key"],
            "additionalProperties": false,
            "properties": {
              "ptsMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854775807
              },
              "key": {
                "$ref": "#/$defs/imageKey"
              }
            }
          }
        }
      }
    },
    "crop": {
      "type": "object",
      "required": ["cropId", "trackLocalId", "ptsMs", "key"],
      "additionalProperties": false,
      "properties": {
        "cropId": {
          "type": "string",
          "format": "uuid",
          "description": "크롭 ID(결정적)"
        },
        "trackLocalId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "description": "청크 안 트랙 ID. 청크를 넘는 연결은 track-stitcher가 한다."
        },
        "ptsMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "key": {
          "$ref": "#/$defs/imageKey"
        }
      }
    }
  },
  "examples": [
    {
      "eventId": "0192f100-0000-7000-8000-0000000000e1",
      "occurredAt": "2026-11-06T09:00:00Z",
      "sourceId": "0192f0d2-1a2b-7c3d-8e4f-5a6b7c8d9e0f",
      "ownerId": "0192f0c4-6d1e-7a3b-9c2d-1e2f3a4b5c6d",
      "jobId": "0192f100-0000-7000-8000-000000000001",
      "chunkId": "0192f100-0000-7000-8000-000000000002",
      "executionId": "0192f100-0000-7000-8000-000000000003",
      "normalizationId": "0192f100-0000-7000-8000-000000000004",
      "eventType": "segment.ready",
      "schemaVersion": 1,
      "segments": [
        {
          "segmentId": "0192f100-0000-7000-8000-0000000000a1",
          "startMs": 0,
          "endMs": 10000,
          "static": false,
          "frames": [
            {
              "ptsMs": 1250,
              "key": "sources/0192f0d2-1a2b-7c3d-8e4f-5a6b7c8d9e0f/jobs/0192f100-0000-7000-8000-000000000001/chunks/0192f100-0000-7000-8000-000000000002/executions/0192f100-0000-7000-8000-000000000003/blurred/0192f100-0000-7000-8000-0000000000a1-0.jpg"
            },
            {
              "ptsMs": 3750,
              "key": "sources/0192f0d2-1a2b-7c3d-8e4f-5a6b7c8d9e0f/jobs/0192f100-0000-7000-8000-000000000001/chunks/0192f100-0000-7000-8000-000000000002/executions/0192f100-0000-7000-8000-000000000003/blurred/0192f100-0000-7000-8000-0000000000a1-1.jpg"
            },
            {
              "ptsMs": 6250,
              "key": "sources/0192f0d2-1a2b-7c3d-8e4f-5a6b7c8d9e0f/jobs/0192f100-0000-7000-8000-000000000001/chunks/0192f100-0000-7000-8000-000000000002/executions/0192f100-0000-7000-8000-000000000003/blurred/0192f100-0000-7000-8000-0000000000a1-2.jpg"
            },
            {
              "ptsMs": 8750,
              "key": "sources/0192f0d2-1a2b-7c3d-8e4f-5a6b7c8d9e0f/jobs/0192f100-0000-7000-8000-000000000001/chunks/0192f100-0000-7000-8000-000000000002/executions/0192f100-0000-7000-8000-000000000003/blurred/0192f100-0000-7000-8000-0000000000a1-3.jpg"
            }
          ]
        }
      ],
      "crops": [
        {
          "cropId": "0192f100-0000-7000-8000-0000000000c1",
          "trackLocalId": "t3",
          "ptsMs": 4200,
          "key": "sources/0192f0d2-1a2b-7c3d-8e4f-5a6b7c8d9e0f/jobs/0192f100-0000-7000-8000-000000000001/chunks/0192f100-0000-7000-8000-000000000002/executions/0192f100-0000-7000-8000-000000000003/blurred/crop-t3-4200.jpg"
        }
      ]
    }
  ]
}
