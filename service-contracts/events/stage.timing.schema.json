{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vlm.example/contracts/events/stage.timing.schema.json",
  "title": "StageTimingBatch",
  "description": "소비 핸들러 하나가 끝날 때 그 안의 측정 기록을 묶은 메시지(ADR-0010 ⑩, SPEC-013). 비즈니스 이벤트가 아니라 측정 기록이라 이벤트 봉투(소유자 등)를 쓰지 않는다. 핸들러가 실패해도 보낸다. 메시지 키는 측정 대상의 sourceId이고 없으면 batchId다. 발행: 공통 메시징 라이브러리를 쓰는 모든 소비자. 소비: quality-service. 토픽 보존 7일.",
  "type": "object",
  "required": ["batchId", "service", "pod", "producedAt", "timings"],
  "additionalProperties": false,
  "properties": {
    "batchId": {
      "type": "string",
      "format": "uuid",
      "description": "uuid5(소비 그룹, 토픽, 파티션, offset, 시도 번호). 같은 메시지를 같은 시도로 다시 처리하면 같은 값이다."
    },
    "service": { "type": "string", "minLength": 1, "description": "발행한 서비스 이름" },
    "pod": { "type": "string", "minLength": 1, "description": "발행한 Pod(호스트) 이름" },
    "producedAt": { "type": "string", "format": "date-time", "description": "이 묶음을 보낸 시각(UTC)" },
    "timings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "../stages/v1/stage-timing.schema.json" }
    }
  },
