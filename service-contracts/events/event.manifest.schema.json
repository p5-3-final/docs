{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vlm.example/contracts/events/event.manifest.schema.json",
  "title": "EventManifest",
  "description": "청크 실행 하나의 event.candidate 판정이 끝났다. 실행마다 한 번, 그 실행의 event.analyzed를 모두 발행한 뒤 발행한다(같은 실행이면 같은 eventId). pipeline-service가 완료 판정에 세고 analysis-api가 저장 수와 비교한다. 벡터 후보(event.candidate.vector)는 세지 않는다. 발행: event-analyzer. 소비: pipeline-service, analysis-api, stream-service(STREAM만, SPEC-036 R-7) (SPEC-023 R-12)",
  "type": "object",
  "allOf": [
    {
      "$ref": "_envelope.schema.json"
    }
  ],
  "required": [
    "jobId",
    "chunkId",
    "executionId",
    "normalizationId",
    "candidateCount",
    "mergedCount",
    "analyzedCount",
    "analyzedEventIds",
    "unsupportedEvents",
    "detectorProfile",
    "taxonomyVersion"
  ],
  "properties": {
    "eventType": {
      "const": "event.manifest"
    },
    "schemaVersion": {
      "const": 1
    },
    "jobType": {
      "type": "string",
      "enum": [
        "FULL",
        "REANALYZE",
        "REEMBED",
        "STREAM"
      ],
      "description": "Job 유형(v5.1, ADR-0015). 없으면 FULL. STREAM이면 실시간 창(stream-ingestor)이고 track-stitcher·pipeline-service는 건너뛴다."
    },
    "jobId": {
      "type": "string",
      "format": "uuid"
    },
    "chunkId": {
      "type": "string",
      "format": "uuid"
    },
    "executionId": {
      "type": "string",
      "format": "uuid"
    },
    "normalizationId": {
      "type": "string",
      "format": "uuid"
    },
    "candidateCount": {
      "type": "integer",
      "minimum": 0,
      "description": "받은 후보 수"
    },
    "mergedCount": {
      "type": "integer",
      "minimum": 0,
      "description": "쿨다운 병합으로 다른 후보에 합쳐진 후보 수"
    },
    "analyzedCount": {
      "type": "integer",
      "minimum": 0,
      "description": "발행한 event.analyzed 수(= candidateCount - mergedCount)"
    },
    "analyzedEventIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "description": "발행한 event.analyzed의 eventId. analysis-api가 빠진 것을 찾는다"
    },
    "unsupportedEvents": {
      "type": "object",
      "description": "판정하지 않은 유형과 이유(예: 구역 정의 없음, 선언한 탐지기 없음). 키는 이벤트 유형",
      "propertyNames": {
        "$ref": "../taxonomy/v2/taxonomy.schema.json#/$defs/detectableEventType"
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 200
      }
    },
    "detectorProfile": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,99}$"
    },
    "taxonomyVersion": {
      "const": "v2"
    },
    "carriedCount": {
      "type": "integer",
      "minimum": 0,
      "description": "rule+carry로 발행한 수(v5.1, SPEC-023 R-20)"
    },
    "capReachedCount": {
      "type": "integer",
      "minimum": 0,
      "description": "실행당 호출 상한으로 unverified가 된 수(v5.1, SPEC-023 R-19·R-20)"
    },
    "budgetExceededCount": {
      "type": "integer",
      "minimum": 0,
      "description": "예산 초과로 unverified가 된 수(v5.1, SPEC-023 R-20)"
    }
  },
  "examples": [
    {
      "eventId": "0192f100-0000-5000-8000-0000000000a6",
      "eventType": "event.manifest",
      "schemaVersion": 1,
      "occurredAt": "2026-11-06T09:00:20Z",
      "sourceId": "0192f0d2-1a2b-7c3d-8e4f-5a6b7c8d9e0f",
      "ownerId": "0192f0c4-6d1e-7a3b-9c2d-1e2f3a4b5c6d",
      "jobId": "0192f100-0000-7000-8000-000000000001",
      "chunkId": "0192f100-0000-7000-8000-000000000002",
      "executionId": "0192f100-0000-7000-8000-000000000003",
      "normalizationId": "0192f100-0000-7000-8000-000000000004",
      "candidateCount": 2,
      "mergedCount": 0,
      "analyzedCount": 2,
      "analyzedEventIds": [
        "0192f100-0000-5000-8000-0000000000f2",
        "0192f100-0000-5000-8000-0000000000f3"
      ],
      "unsupportedEvents": {
        "fall": "자세 추정 탐지기 없음",
        "object_removed": "구역 정의 없음"
      },
      "detectorProfile": "industrial-default@1",
      "taxonomyVersion": "v2"
    }
  ]
}
