{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vlm.example/contracts/events/_risk-forecast.schema.json",
  "title": "RiskForecast",
  "description": "ai-gateway risk_forecast 출력. 영상 끝에 활성인 위험 하나의 다음 구간 노출 확률(SPEC-028). 1단계는 규칙 점수(method rule), 학습 모델은 AI 담당자가 바꾼다",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "method",
    "horizons",
    "features"
  ],
  "properties": {
    "method": {
      "type": "string",
      "enum": [
        "rule",
        "model"
      ]
    },
    "horizons": {
      "type": "array",
      "description": "예측 구간별 노출 확률. 예측 모델이 설정되지 않아 대체 결과를 낼 때는 빈 배열이다(SPEC-028 R-15)",
      "minItems": 0,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "horizonSec",
          "exposureProbability"
        ],
        "properties": {
          "horizonSec": {
            "type": "integer",
            "minimum": 60,
            "maximum": 86400
          },
          "exposureProbability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "features": {
      "type": "object",
      "description": "점수에 쓴 특징과 값(근거 표시용). 키는 영어 snake_case",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "type": "number"
      }
    }
  },
  "examples": [
    {
      "method": "rule",
      "horizons": [
        {
          "horizonSec": 600,
          "exposureProbability": 0.42
        },
        {
          "horizonSec": 1800,
          "exposureProbability": 0.71
        }
      ],
      "features": {
        "active_seconds": 1200.0,
        "zone_entries_per_minute": 0.8
      }
    }
  ]
}
