{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vlm.example/contracts/events/version.activated.schema.json",
  "title": "VersionActivated",
  "description": "소스의 활성 분석 버전이 바뀜. 전환마다 한 번, sequence는 소스 안에서 증가한다(eventId는 sourceId·sequence로 결정적). search-service는 검색 대상 버전을 이 값으로 바꾼다. 발행: analysis-api(업로드, 다른 담당자, 생산자 확인 필요), stream-service(STREAM 세션 시작에 sequence 1, SPEC-036 R-3). 소비: search-service(생산자 확인 필요). v5.1에서 소비·발행 쪽(stream-service)이 아키텍처 11.2절대로 먼저 정했다",
  "type": "object",
  "allOf": [
    {
      "$ref": "_envelope.schema.json"
    }
  ],
  "required": [
    "jobId",
    "jobType",
    "normalizationId",
    "sequence",
    "previousJobId"
  ],
  "properties": {
    "eventType": {
      "const": "version.activated"
    },
    "schemaVersion": {
      "const": 1
    },
    "jobId": {
      "type": "string",
      "format": "uuid",
      "description": "활성이 된 분석 버전의 Job"
    },
    "jobType": {
      "$ref": "segment.ready.schema.json#/properties/jobType"
    },
    "normalizationId": {
      "type": "string",
      "format": "uuid"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "previousJobId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "description": "직전 활성 버전의 Job. 첫 활성이면 null"
    }
  },
  "examples": [
    {
      "eventId": "0192fb00-0000-5000-8000-000000000007",
      "eventType": "version.activated",
      "schemaVersion": 1,
      "occurredAt": "2026-11-06T10:00:00Z",
      "sourceId": "0192fb00-0000-7000-8000-000000000010",
      "ownerId": "0192f0c4-6d1e-7a3b-9c2d-1e2f3a4b5c6d",
      "jobId": "0192fb00-0000-7000-8000-000000000030",
      "jobType": "STREAM",
      "normalizationId": "0192fb00-0000-7000-8000-000000000010",
      "sequence": 1,
      "previousJobId": null
    }
  ]
}
