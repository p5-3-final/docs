{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vlm.example/contracts/events/source.completed.schema.json",
  "title": "SourceCompleted",
  "description": "영상 단위 집계 완료. job마다 한 번 발행하고, 늦은 벡터 이벤트가 오면 revision을 올려 다시 발행한다(eventId는 jobId·revision으로 결정적). 본문은 결과 파일에 있다. 발행: aggregator. 소비: analysis-api, notification-service (SPEC-027)",
  "type": "object",
  "allOf": [
    {
      "$ref": "_envelope.schema.json"
    }
  ],
  "required": [
    "jobId",
    "normalizationId",
    "resultKey",
    "aggregateProfile",
    "session",
    "counts",
    "summaryStatus"
  ],
  "properties": {
    "eventType": {
      "const": "source.completed"
    },
    "schemaVersion": {
      "const": 1
    },
    "jobType": {
      "type": "string",
      "enum": [
        "FULL",
        "REANALYZE",
        "REEMBED",
        "STREAM"
      ],
      "description": "Job 유형(v5.1, ADR-0015). 없으면 FULL. STREAM이면 실시간 창(stream-ingestor)이고 track-stitcher·pipeline-service는 건너뛴다."
    },
    "jobId": {
      "type": "string",
      "format": "uuid"
    },
    "normalizationId": {
      "type": "string",
      "format": "uuid"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "description": "같은 jobId의 발행 차수(v5.1, SPEC-027 R-27·R-28). 늦은 벡터 이벤트로 다시 내면 1 올린다. 없으면 1. 소비자는 저장된 값보다 작으면 버린다"
    },
    "partial": {
      "type": "boolean",
      "description": "개수 대조 재시도 상한 뒤 빠진 이벤트가 있는 채로 발행함(v5.1, SPEC-027 R-4). 없으면 false"
    },
    "missingCounts": {
      "type": "object",
      "additionalProperties": false,
      "description": "partial일 때 counts와 읽은 수의 차이",
      "properties": {
        "events": {
          "type": "integer",
          "minimum": 0
        },
        "tracks": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "resultKey": {
      "type": "string",
      "pattern": "^sources/[0-9a-f-]{36}/jobs/[0-9a-f-]{36}/aggregate/source-result[.]json$",
      "description": "결과 파일(aggregates/v1/source-result.schema.json)"
    },
    "aggregateProfile": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,99}$"
    },
    "session": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sessionId",
            "role",
            "previousSourceId"
          ],
          "properties": {
            "sessionId": {
              "type": "string",
              "format": "uuid"
            },
            "role": {
              "type": "string",
              "enum": [
                "BEFORE",
                "DURING",
                "AFTER"
              ]
            },
            "previousSourceId": {
              "type": [
                "string",
                "null"
              ],
              "format": "uuid",
              "description": "세션에서 이 영상 바로 앞 영상(역할 BEFORE→DURING→AFTER, 같은 역할이면 업로드 순). 없으면 null"
            }
          }
        },
        {
          "type": "null"
        }
      ],
      "description": "작업 세션(SPEC-017). 세션에 속하지 않으면 null"
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputEvents",
        "confirmedEvents",
        "mergeGroups",
        "ruleEvents",
        "snapshots",
        "risks",
        "activeRisksAtEnd"
      ],
      "description": "결과 파일의 항목 수. analysis-api가 저장 수와 맞춰 본다",
      "properties": {
        "inputEvents": {
          "type": "integer",
          "minimum": 0
        },
        "confirmedEvents": {
          "type": "integer",
          "minimum": 0
        },
        "mergeGroups": {
          "type": "integer",
          "minimum": 0
        },
        "ruleEvents": {
          "type": "integer",
          "minimum": 0
        },
        "snapshots": {
          "type": "integer",
          "minimum": 0
        },
        "risks": {
          "type": "integer",
          "minimum": 0
        },
        "activeRisksAtEnd": {
          "type": "integer",
          "minimum": 0
        },
        "inventoryEvents": {
          "type": "integer",
          "minimum": 0,
          "description": "SPEC-028"
        },
        "forecasts": {
          "type": "integer",
          "minimum": 0,
          "description": "SPEC-028"
        }
      }
    },
    "summaryStatus": {
      "$ref": "../aggregates/v1/source-result.schema.json#/properties/summary/properties/status"
    }
  },
  "examples": [
    {
      "eventId": "0192f700-0000-5000-8000-000000000001",
      "eventType": "source.completed",
      "schemaVersion": 1,
      "occurredAt": "2026-11-06T10:00:00Z",
      "sourceId": "0192f0d2-1a2b-7c3d-8e4f-5a6b7c8d9e0f",
      "ownerId": "0192f0c4-6d1e-7a3b-9c2d-1e2f3a4b5c6d",
      "jobId": "0192f0d5-0000-7000-8000-000000000001",
      "normalizationId": "0192f0d4-0000-7000-8000-000000000001",
      "resultKey": "sources/0192f0d2-1a2b-7c3d-8e4f-5a6b7c8d9e0f/jobs/0192f0d5-0000-7000-8000-000000000001/aggregate/source-result.json",
      "aggregateProfile": "aggregate-v1",
      "session": {
        "sessionId": "0192f0e0-5a6b-7c8d-9e0f-1a2b3c4d5e6f",
        "role": "AFTER",
        "previousSourceId": "0192f0d2-0000-7000-8000-0000000000aa"
      },
      "counts": {
        "inputEvents": 3,
        "confirmedEvents": 2,
        "mergeGroups": 1,
        "ruleEvents": 1,
        "snapshots": 1,
        "risks": 1,
        "activeRisksAtEnd": 1
      },
      "summaryStatus": "generated"
    }
  ]
}
