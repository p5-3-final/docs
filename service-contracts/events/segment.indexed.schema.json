{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vlm.example/contracts/events/segment.indexed.schema.json",
  "title": "SegmentIndexed",
  "description": "실행 하나의 구간·크롭 벡터가 search_db에 적재됨. 실행마다 한 번(같은 실행이면 같은 eventId). 발행: search-service(다른 담당자, 생산자 확인 필요). 소비: pipeline-service, stream-service(jobType STREAM만, SPEC-036 R-7). v5.1에서 소비 쪽(stream-service)이 아키텍처 11.2절대로 먼저 정했다",
  "type": "object",
  "allOf": [
    {
      "$ref": "_envelope.schema.json"
    }
  ],
  "required": [
    "jobId",
    "chunkId",
    "executionId",
    "normalizationId",
    "embeddingModel",
    "counts"
  ],
  "properties": {
    "eventType": {
      "const": "segment.indexed"
    },
    "schemaVersion": {
      "const": 1
    },
    "jobId": {
      "type": "string",
      "format": "uuid"
    },
    "jobType": {
      "$ref": "segment.ready.schema.json#/properties/jobType"
    },
    "chunkId": {
      "type": "string",
      "format": "uuid"
    },
    "executionId": {
      "type": "string",
      "format": "uuid"
    },
    "normalizationId": {
      "type": "string",
      "format": "uuid"
    },
    "embeddingModel": {
      "type": "string",
      "pattern": "^[^:\\s]+:[^:\\s]+:[^:\\s]+:[^:\\s]+$"
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segments",
        "crops"
      ],
      "properties": {
        "segments": {
          "type": "integer",
          "minimum": 0
        },
        "crops": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "examples": [
    {
      "eventId": "0192fb00-0000-5000-8000-000000000006",
      "eventType": "segment.indexed",
      "schemaVersion": 1,
      "occurredAt": "2026-11-06T10:05:23Z",
      "sourceId": "0192fb00-0000-7000-8000-000000000010",
      "ownerId": "0192f0c4-6d1e-7a3b-9c2d-1e2f3a4b5c6d",
      "jobId": "0192fb00-0000-7000-8000-000000000030",
      "jobType": "STREAM",
      "chunkId": "0192fb00-0000-5000-8000-00000000000f",
      "executionId": "0192fb00-0000-7000-8000-000000000040",
      "normalizationId": "0192fb00-0000-7000-8000-000000000010",
      "embeddingModel": "open_clip:MobileCLIP2-S0:dfndr2b:mean-4",
      "counts": {
        "segments": 4,
        "crops": 6
      }
    }
  ]
}
