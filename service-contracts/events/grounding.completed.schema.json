{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vlm.example/contracts/events/grounding.completed.schema.json",
  "title": "GroundingCompleted",
  "description": "주석 구간 하나의 처리 결과. grounding.requested의 segments 항목마다 한 번 발행한다(같은 groundingId·탐지기 버전이면 같은 eventId). 실패도 outcome FAILED로 발행한다. 발행: grounding-worker. 소비: search-service, notification-service (SPEC-026)",
  "type": "object",
  "allOf": [
    {
      "$ref": "_envelope.schema.json"
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "READY"
          }
        }
      },
      "then": {
        "properties": {
          "clipKey": {
            "type": "string"
          },
          "resultKey": {
            "type": "string"
          },
          "frames": {
            "type": "array"
          },
          "errorCode": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "FAILED"
          }
        }
      },
      "then": {
        "properties": {
          "clipKey": {
            "type": "null"
          },
          "resultKey": {
            "type": "null"
          },
          "frames": {
            "type": "null"
          },
          "errorCode": {
            "type": "string"
          }
        }
      }
    }
  ],
  "required": [
    "requestId",
    "jobId",
    "groundingId",
    "segmentId",
    "startMs",
    "endMs",
    "targets",
    "groundingModel",
    "outcome",
    "clipKey",
    "resultKey",
    "frames",
    "errorCode"
  ],
  "properties": {
    "eventType": {
      "const": "grounding.completed"
    },
    "schemaVersion": {
      "const": 1
    },
    "requestId": {
      "type": "string",
      "format": "uuid"
    },
    "jobId": {
      "type": "string",
      "format": "uuid"
    },
    "groundingId": {
      "type": "string",
      "format": "uuid"
    },
    "segmentId": {
      "type": "string",
      "format": "uuid"
    },
    "startMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "endMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9 '-]{0,79}$",
        "description": "영어 소문자 명사구(ai-gateway /v1/parse의 시각 대상어). 예: person without a hard hat"
      },
      "description": "대상어 1~3개. 탐지기 텍스트 클래스로 쓴다"
    },
    "groundingModel": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$",
      "description": "grounding 탐지기 버전(가중치 manifest의 version). S3 경로 한 단계로 쓰므로 콜론·슬래시가 없다"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "READY",
        "FAILED"
      ],
      "description": "READY: 클립과 결과 파일 저장(객체 0개 포함), FAILED: 클립 없이 끝남. search-service bbox 주석 상태와 같은 이름이다"
    },
    "clipKey": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sources/[0-9a-f-]{36}/groundings/[0-9a-f-]{36}/[A-Za-z0-9._-]{1,100}/clip[.]mp4$"
        },
        {
          "type": "null"
        }
      ],
      "description": "주석 클립(H.264 mp4, 원본 fps, 오디오 유지). READY만"
    },
    "resultKey": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sources/[0-9a-f-]{36}/groundings/[0-9a-f-]{36}/[A-Za-z0-9._-]{1,100}/result[.]json$"
        },
        {
          "type": "null"
        }
      ],
      "description": "grounding 결과 파일(groundings/v1/grounding-result.schema.json). READY만"
    },
    "frames": {
      "anyOf": [
        {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ptsMs",
              "counts"
            ],
            "properties": {
              "ptsMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854775807
              },
              "counts": {
                "type": "object",
                "description": "대상어별 객체 수(기준 신뢰도 이상). 키는 targets 값",
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000
                }
              }
            }
          }
        },
        {
          "type": "null"
        }
      ],
      "description": "샘플 프레임별 객체 수. READY만, 시각 순"
    },
    "errorCode": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "GROUNDING_SOURCE_UNREADABLE",
            "GROUNDING_SEGMENT_OUT_OF_RANGE",
            "GROUNDING_DETECTOR_FAILED",
            "GROUNDING_TIMEOUT"
          ]
        },
        {
          "type": "null"
        }
      ],
      "description": "FAILED만"
    }
  },
  "examples": [
    {
      "eventId": "0192f312-0000-5000-8000-000000000001",
      "eventType": "grounding.completed",
      "schemaVersion": 1,
      "occurredAt": "2026-11-06T09:00:00Z",
      "sourceId": "0192f0d2-1a2b-7c3d-8e4f-5a6b7c8d9e0f",
