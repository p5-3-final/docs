      "resultKey": "sources/0192f0d2-1a2b-7c3d-8e4f-5a6b7c8d9e0f/groundings/0192f300-0000-5000-8000-0000000000a1/yoloe-v8s-seg-v1/result.json",
      "frames": [
        {
          "ptsMs": 40000,
