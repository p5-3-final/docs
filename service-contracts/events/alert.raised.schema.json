{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vlm.example/contracts/events/alert.raised.schema.json",
  "title": "AlertRaised",
  "description": "실시간 긴급 알림(v5.1, ADR-0016). 긴급 후보마다 pending 1건을 탐지기 근거만으로 먼저 내고, event_judge 판정 뒤 confirmed 또는 dismissed 1건을 낸다. eventId는 candidateId·status로 결정적이다. 이벤트 저장은 하지 않는다(창 후보가 event.analyzed로 저장). 발행: event-analyzer (SPEC-023 R-21~R-23). 소비: notification-service(생산자 확인 필요), stream-service (SPEC-036 R-18), quality-service (SPEC-029 R-28)",
  "type": "object",
  "allOf": [
    {
      "$ref": "_envelope.schema.json"
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "confirmed"
          }
        }
      },
      "then": {
        "required": [
          "analysis"
        ],
        "properties": {
          "analysis": {
            "type": "object"
          }
        }
      }
    }
  ],
  "required": [
    "jobId",
    "cameraId",
    "candidateId",
    "status",
    "candidateEventType",
    "reason",
    "severity",
    "trackId",
    "zoneId",
    "observedMs",
    "evidenceFrameKeys",
    "analysis",
    "dismissReason",
    "taxonomyVersion"
  ],
  "properties": {
    "eventType": {
      "const": "alert.raised"
    },
    "schemaVersion": {
      "const": 1
    },
    "jobId": {
      "type": "string",
      "format": "uuid"
    },
    "cameraId": {
      "type": "string",
      "format": "uuid"
    },
    "candidateId": {
      "type": "string",
      "format": "uuid",
      "description": "alert.candidate와 같다. 소비자는 이 값으로 pending을 confirmed·dismissed로 바꾼다"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "dismissed"
      ]
    },
    "candidateEventType": {
      "$ref": "../taxonomy/v2/taxonomy.schema.json#/$defs/detectableEventType"
    },
    "reason": {
      "$ref": "alert.candidate.schema.json#/properties/reason"
    },
    "severity": {
      "$ref": "../taxonomy/v2/taxonomy.schema.json#/$defs/severity",
      "description": "pending은 이벤트 정의 기본 severity, confirmed는 판정 severity(null이면 기본값)"
    },
    "trackId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "zoneId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "observedMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "evidenceFrameKeys": {
      "$ref": "alert.candidate.schema.json#/properties/evidenceFrameKeys"
    },
    "analysis": {
      "anyOf": [
        {
          "$ref": "_vlm-analysis.schema.json"
        },
        {
          "type": "null"
        }
      ],
      "description": "confirmed면 VLMAnalysis, pending·dismissed면 null"
    },
    "dismissReason": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "rejected",
        "unverified",
        "unknown",
        null
      ],
      "description": "dismissed일 때: rejected(모델이 아니라고 판정), unverified(예산·모델 미설정), unknown(출력 검증·호출 실패). 아니면 null (SPEC-023 R-23)"
    },
    "taxonomyVersion": {
      "const": "v2"
    }
  },
  "examples": [
    {
      "eventId": "0192fb00-0000-5000-8000-000000000003",
      "eventType": "alert.raised",
      "schemaVersion": 1,
      "occurredAt": "2026-11-06T10:05:04Z",
      "sourceId": "0192fb00-0000-7000-8000-000000000010",
      "ownerId": "0192f0c4-6d1e-7a3b-9c2d-1e2f3a4b5c6d",
      "jobId": "0192fb00-0000-7000-8000-000000000030",
      "cameraId": "0192fb00-0000-7000-8000-000000000020",
      "candidateId": "0192fb00-0000-5000-8000-0000000000c1",
      "status": "pending",
      "candidateEventType": "fall",
      "reason": "severity_high",
      "severity": "high",
      "trackId": "0192fb00-0000-5000-8000-0000000000a1",
      "zoneId": null,
      "observedMs": 302800,
      "evidenceFrameKeys": [
        "sources/0192fb00-0000-7000-8000-000000000010/jobs/0192fb00-0000-7000-8000-000000000030/chunks/0192fb00-0000-5000-8000-00000000000f/executions/0192fb00-0000-7000-8000-000000000040/blurred/f302400.jpg"
      ],
      "analysis": null,
      "dismissReason": null,
      "taxonomyVersion": "v2"
    },
    {
      "eventId": "0192fb00-0000-5000-8000-000000000004",
      "eventType": "alert.raised",
      "schemaVersion": 1,
      "occurredAt": "2026-11-06T10:05:08Z",
      "sourceId": "0192fb00-0000-7000-8000-000000000010",
      "ownerId": "0192f0c4-6d1e-7a3b-9c2d-1e2f3a4b5c6d",
      "jobId": "0192fb00-0000-7000-8000-000000000030",
      "cameraId": "0192fb00-0000-7000-8000-000000000020",
      "candidateId": "0192fb00-0000-5000-8000-0000000000c1",
      "status": "confirmed",
      "candidateEventType": "fall",
      "reason": "severity_high",
      "severity": "high",
      "trackId": "0192fb00-0000-5000-8000-0000000000a1",
      "zoneId": null,
      "observedMs": 302800,
      "evidenceFrameKeys": [
        "sources/0192fb00-0000-7000-8000-000000000010/jobs/0192fb00-0000-7000-8000-000000000030/chunks/0192fb00-0000-5000-8000-00000000000f/executions/0192fb00-0000-7000-8000-000000000040/blurred/f302400.jpg"
      ],
      "analysis": {
        "eventType": "fall",
        "eventDetected": true,
        "verificationStatus": "confirmed",
        "description": "작업자 한 명이 바닥에 쓰러져 움직이지 않습니다.",
        "beforeState": null,
        "afterState": "작업자 쓰러짐",
        "riskDetected": true,
        "riskType": "fall",
        "riskReason": "쓰러진 작업자",
        "solution": "즉시 현장 확인. 안전관리자 확인 필요",
        "severity": "high",
        "evidenceStart": 302.4,
        "evidenceEnd": 302.8
      },
      "dismissReason": null,
      "taxonomyVersion": "v2"
    }
  ]
}
