      "ownerId": "0192f0c4-6d1e-7a3b-9c2d-1e2f3a4b5c6d",
      "normalizationId": "0192f0d4-0000-7000-8000-000000000002",
      "normalizationVersion": "normalize-v1",
      "result": "REJECTED",
      "normalizedKey": null,
      "hlsPlaylistKey": null,
      "durationMs": null,
