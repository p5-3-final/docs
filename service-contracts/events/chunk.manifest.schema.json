{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vlm.example/contracts/events/chunk.manifest.schema.json",
  "title": "ChunkManifest",
  "description": "청크 실행 하나의 산출물 개수·탐지기 능력·정적 객체 재고. 실행마다 마지막에 한 번 발행한다. 실행 완료 계약이 아니다(실행 완료는 chunk.execution.finished). 발행: chunk-processor(다른 담당자, 생산자 확인 필요), stream-ingestor(jobType STREAM, SPEC-037). 소비: aggregator (SPEC-028), pipeline-service, stream-service(STREAM만, SPEC-036)",
  "type": "object",
  "allOf": [
    {
      "$ref": "_envelope.schema.json"
    }
  ],
  "required": [
    "jobId",
    "chunkId",
    "executionId",
    "normalizationId",
    "ownedRange",
    "counts",
    "detector",
    "unsupportedEvents",
    "staticObjects",
    "referenceFrames"
  ],
  "properties": {
    "eventType": {
      "const": "chunk.manifest"
    },
    "schemaVersion": {
      "const": 1
    },
    "jobType": {
      "type": "string",
      "enum": [
        "FULL",
        "REANALYZE",
        "REEMBED",
        "STREAM"
      ],
      "description": "Job 유형(v5.1, ADR-0015). 없으면 FULL. STREAM이면 실시간 창(stream-ingestor)이고 track-stitcher·pipeline-service는 건너뛴다."
    },
    "trackIdEpoch": {
      "type": "integer",
      "minimum": 0,
      "description": "실시간(STREAM) 트랙 ID 대역 번호(v5.1, SPEC-037 R-9)"
    },
    "last": {
      "type": "boolean",
      "description": "실시간(STREAM) 세션의 마지막 창(v5.1, SPEC-037 R-14). stream-service가 이 창까지 완료되면 analysis.completed(scope: job)를 낸다"
    },
    "gapMs": {
      "type": "integer",
      "minimum": 0,
      "description": "실시간(STREAM)에서 RTSP 재연결 뒤 첫 창에 기록하는 끊긴 시간(v5.1, SPEC-037 R-17)"
    },
    "jobId": {
      "type": "string",
      "format": "uuid"
    },
    "chunkId": {
      "type": "string",
      "format": "uuid"
    },
    "executionId": {
      "type": "string",
      "format": "uuid"
    },
    "normalizationId": {
      "type": "string",
      "format": "uuid"
    },
    "ownedRange": {
      "$ref": "chunk.requested.schema.json#/properties/ownedRange"
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segments",
        "candidates",
        "tracks"
      ],
      "properties": {
        "segments": {
          "type": "integer",
          "minimum": 0
        },
        "candidates": {
          "type": "integer",
          "minimum": 0
        },
        "tracks": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "detector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "detectorProfile",
        "models",
        "supportedEvents"
      ],
      "description": "이 실행의 탐지기 능력 선언(탐지 프로필)",
      "properties": {
        "detectorProfile": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,99}$"
        },
        "models": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "modelId",
              "available"
            ],
            "properties": {
              "modelId": {
                "type": "string",
                "maxLength": 128
              },
              "available": {
                "type": "boolean"
              }
            }
          }
        },
        "supportedEvents": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "../taxonomy/v2/taxonomy.schema.json#/$defs/detectableEventType"
          }
        }
      }
    },
    "unsupportedEvents": {
      "type": "object",
      "description": "판정하지 않은 유형과 이유(예: 구역 정의 없음, 선언한 탐지기 없음). 키는 이벤트 유형",
      "propertyNames": {
        "$ref": "../taxonomy/v2/taxonomy.schema.json#/$defs/detectableEventType"
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 200
      }
    },
    "staticObjects": {
      "type": "array",
      "maxItems": 500,
      "description": "소유 범위 안에서 움직이지 않은 객체 재고(v4 ⑤). 탐지 프로필의 재고 클래스만. 프레임 경로는 이 실행 폴더의 blurred/ 아래",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "objectLocalId",
          "className",
          "box",
          "zoneId",
          "firstSeenMs",
          "lastSeenMs",
          "observationCount",
          "frameKey"
        ],
        "properties": {
          "objectLocalId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "description": "청크 실행 안의 정적 객체 ID"
          },
          "className": {
            "$ref": "../taxonomy/v2/taxonomy.schema.json#/$defs/className"
          },
          "box": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "y",
              "w",
              "h"
            ],
            "description": "프레임 크기로 나눈 0~1 좌표, 왼쪽 위 기준",
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "w": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "h": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "zoneId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "firstSeenMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "lastSeenMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "observationCount": {
            "type": "integer",
            "minimum": 1
          },
          "frameKey": {
            "$ref": "segment.ready.schema.json#/$defs/imageKey"
          }
        }
      }
    },
    "referenceFrames": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "description": "재고 비교의 '이후' 장면으로 쓰는 기준 프레임. 소유 범위 시작·끝과 그 사이 균등 간격(최대 8장). 이 실행 폴더의 blurred/ 아래",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ptsMs",
          "key"
        ],
        "properties": {
          "ptsMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "key": {
            "$ref": "segment.ready.schema.json#/$defs/imageKey"
          }
        }
      }
    }
  },
  "examples": [
    {
      "eventId": "0192f800-0000-7000-8000-000000000001",
      "eventType": "chunk.manifest",
      "schemaVersion": 1,
      "occurredAt": "2026-11-06T09:00:00Z",
      "sourceId": "0192f0d2-1a2b-7c3d-8e4f-5a6b7c8d9e0f",
      "ownerId": "0192f0c4-6d1e-7a3b-9c2d-1e2f3a4b5c6d",
      "jobId": "0192f0d5-0000-7000-8000-000000000001",
      "chunkId": "0192f0d6-0000-7000-8000-000000000001",
      "executionId": "0192f0d7-0000-7000-8000-000000000001",
      "normalizationId": "0192f0d4-0000-7000-8000-000000000001",
      "ownedRange": {
        "startMs": 0,
        "endMs": 60000
      },
      "counts": {
        "segments": 12,
        "candidates": 1,
        "tracks": 4
      },
      "detector": {
        "detectorProfile": "detect-v1",
        "models": [
          {
            "modelId": "yolo26n",
            "available": true
          }
        ],
        "supportedEvents": [
          "fall"
        ]
      },
      "unsupportedEvents": {
        "barrier_not_restored": "구역 정의 없음"
      },
      "staticObjects": [
        {
          "objectLocalId": "s1",
          "className": "safety_barrier",
          "box": {
            "x": 0.1,
            "y": 0.5,
            "w": 0.2,
            "h": 0.15
          },
          "zoneId": "0192f100-0000-7000-8000-0000000000f1",
          "firstSeenMs": 0,
          "lastSeenMs": 41000,
          "observationCount": 82,
          "frameKey": "sources/0192f0d2-1a2b-7c3d-8e4f-5a6b7c8d9e0f/jobs/0192f0d5-0000-7000-8000-000000000001/chunks/0192f0d6-0000-7000-8000-000000000001/executions/0192f0d7-0000-7000-8000-000000000001/blurred/static-s1.jpg"
        }
      ],
      "referenceFrames": [
        {
          "ptsMs": 0,
          "key": "sources/0192f0d2-1a2b-7c3d-8e4f-5a6b7c8d9e0f/jobs/0192f0d5-0000-7000-8000-000000000001/chunks/0192f0d6-0000-7000-8000-000000000001/executions/0192f0d7-0000-7000-8000-000000000001/blurred/ref-0.jpg"
        },
        {
          "ptsMs": 30000,
          "key": "sources/0192f0d2-1a2b-7c3d-8e4f-5a6b7c8d9e0f/jobs/0192f0d5-0000-7000-8000-000000000001/chunks/0192f0d6-0000-7000-8000-000000000001/executions/0192f0d7-0000-7000-8000-000000000001/blurred/ref-30000.jpg"
        },
        {
          "ptsMs": 59900,
          "key": "sources/0192f0d2-1a2b-7c3d-8e4f-5a6b7c8d9e0f/jobs/0192f0d5-0000-7000-8000-000000000001/chunks/0192f0d6-0000-7000-8000-000000000001/executions/0192f0d7-0000-7000-8000-000000000001/blurred/ref-59900.jpg"
        }
      ]
    }
  ]
}
