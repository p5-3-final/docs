{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vlm.example/contracts/events/analysis.completed.schema.json",
  "title": "AnalysisCompleted",
  "description": "job의 구간 벡터·이벤트 판정·트랙 적재가 모두 끝남(job ANALYZED). job마다 한 번 발행한다. 발행: pipeline-service(다른 담당자, 생산자 확인 필요), stream-service(jobType STREAM, scope job·chunk, SPEC-036). 소비: aggregator (SPEC-027), notification-service",
  "type": "object",
  "allOf": [
    {
      "$ref": "_envelope.schema.json"
    }
  ],
  "required": [
    "jobId",
    "jobType",
    "normalizationId",
    "durationMs",
    "session",
    "counts"
  ],
  "properties": {
    "eventType": {
      "const": "analysis.completed"
    },
    "schemaVersion": {
      "const": 1
    },
    "jobId": {
      "type": "string",
      "format": "uuid"
    },
    "jobType": {
      "type": "string",
      "enum": [
        "FULL",
        "REANALYZE",
        "REEMBED",
        "STREAM"
      ],
      "description": "STREAM은 실시간 세션 Job(v5.1, ADR-0015). 발행자는 stream-service다"
    },
    "scope": {
      "type": "string",
      "enum": [
        "job",
        "chunk"
      ],
      "description": "없으면 job. chunk는 실시간 창 하나의 적재 완료(v5.1, SPEC-036 R-8). counts는 그 창만 센다"
    },
    "chunkId": {
      "type": "string",
      "format": "uuid",
      "description": "scope가 chunk일 때 창 ID(uuid5(sourceId, 순번))"
    },
    "partial": {
      "type": "boolean",
      "description": "실시간 창이 시간 초과로 닫혀 counts가 불완전함(v5.1, SPEC-036 R-9). 없으면 false"
    },
    "normalizationId": {
      "type": "string",
      "format": "uuid"
    },
    "durationMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807,
      "description": "정규화 영상 길이"
    },
    "session": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sessionId",
            "role",
            "previousSourceId"
          ],
          "properties": {
            "sessionId": {
              "type": "string",
              "format": "uuid"
            },
            "role": {
              "type": "string",
              "enum": [
                "BEFORE",
                "DURING",
                "AFTER",
                "ROTATION"
              ],
              "description": "ROTATION은 실시간 24시간 회전(v5.1, SPEC-036 R-12). sessionId는 카메라 ID로 결정적이다"
            },
            "previousSourceId": {
              "type": [
                "string",
                "null"
              ],
              "format": "uuid",
              "description": "세션에서 이 영상 바로 앞 영상(역할 BEFORE→DURING→AFTER, 같은 역할이면 업로드 순). 실시간 회전이면 직전 세션의 sourceId. 없으면 null"
            }
          }
        },
        {
          "type": "null"
        }
      ],
      "description": "작업 세션(SPEC-017) 또는 실시간 회전. 세션에 속하지 않으면 null"
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chunks",
        "segments",
        "events",
        "tracks"
      ],
      "description": "완료 판정에 쓴 manifest 합계. aggregator가 읽기 API 결과 수와 맞춰 본다",
      "properties": {
        "chunks": {
          "type": "integer",
          "minimum": 0
        },
        "segments": {
          "type": "integer",
          "minimum": 0
        },
        "events": {
          "type": "integer",
          "minimum": 0
        },
        "tracks": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "examples": [
    {
      "eventId": "0192f400-0000-7000-8000-000000000001",
      "eventType": "analysis.completed",
      "schemaVersion": 1,
      "occurredAt": "2026-11-06T10:00:00Z",
      "sourceId": "0192f0d2-1a2b-7c3d-8e4f-5a6b7c8d9e0f",
      "ownerId": "0192f0c4-6d1e-7a3b-9c2d-1e2f3a4b5c6d",
      "jobId": "0192f0d5-0000-7000-8000-000000000001",
      "jobType": "FULL",
      "normalizationId": "0192f0d4-0000-7000-8000-000000000001",
      "durationMs": 125001,
      "session": {
        "sessionId": "0192f0e0-5a6b-7c8d-9e0f-1a2b3c4d5e6f",
        "role": "AFTER",
        "previousSourceId": "0192f0d2-0000-7000-8000-0000000000aa"
      },
      "counts": {
        "chunks": 2,
        "segments": 24,
        "events": 3,
        "tracks": 5
      }
    },
    {
      "eventId": "0192f400-0000-7000-8000-000000000002",
      "eventType": "analysis.completed",
      "schemaVersion": 1,
      "occurredAt": "2026-11-06T10:00:00Z",
      "sourceId": "0192f0d2-1a2b-7c3d-8e4f-5a6b7c8d9e0f",
      "ownerId": "0192f0c4-6d1e-7a3b-9c2d-1e2f3a4b5c6d",
      "jobId": "0192f0d5-0000-7000-8000-000000000001",
      "jobType": "FULL",
      "normalizationId": "0192f0d4-0000-7000-8000-000000000001",
      "durationMs": 125001,
      "session": null,
      "counts": {
        "chunks": 2,
        "segments": 24,
        "events": 0,
        "tracks": 0
      }
    }
  ]
}
