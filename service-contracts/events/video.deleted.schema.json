{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vlm.example/contracts/events/video.deleted.schema.json",
  "title": "VideoDeleted",
  "description": "영상이 '삭제'(DELETED)로 바뀌었다. 영상마다 한 번 발행한다(재시도 시 같은 eventId). 받은 서비스는 그 sourceId의 데이터를 모두 지운다. 이 이벤트가 video.uploaded보다 먼저 도착할 수 있으므로 소비자는 삭제 흔적을 남긴다. 발행: media-service. 소비: 영상 데이터를 가진 모든 서비스 (SPEC-003 R-19, R-21)",
  "type": "object",
  "allOf": [{ "$ref": "_envelope.schema.json" }],
  "properties": {
    "eventType": { "const": "video.deleted" },
    "schemaVersion": { "const": 1 }
  },
  "examples": [
    {
      "eventId": "0192f0d3-0000-7000-8000-000000000002",
      "eventType": "video.deleted",
      "schemaVersion": 1,
      "occurredAt": "2026-11-02T12:00:00Z",
      "sourceId": "0192f0d2-1a2b-7c3d-8e4f-5a6b7c8d9e0f",
      "ownerId": "0192f0c4-6d1e-7a3b-9c2d-1e2f3a4b5c6d"
    }
  ]
}
