{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vlm.example/contracts/events/track.detected.schema.json",
  "title": "TrackDetected",
  "description": "트랙이 준비됐다. 두 생산자가 같은 토픽에 낸다. origin `chunk`: chunk-processor가 실행마다 한 번, 그 실행의 로컬 트랙 요약 파일과 검출 박스 파일을 알린다(다른 담당자 확인 필요). origin `stitcher`: track-stitcher가 인접 청크 한 쌍의 경계 트랙을 이을 때마다 한 번, 이어진 트랙 묶음을 알린다(SPEC-022 R-5). 최종 번역표는 track.manifest의 mappingKey다. 소비: analysis-api, analysis-loader",
  "type": "object",
  "allOf": [
    {
      "$ref": "_envelope.schema.json"
    }
  ],
  "required": [
    "jobId",
    "normalizationId",
    "origin"
  ],
  "properties": {
    "eventType": {
      "const": "track.detected"
    },
    "schemaVersion": {
      "const": 1
    },
    "jobType": {
      "type": "string",
      "enum": [
        "FULL",
        "REANALYZE",
        "REEMBED",
        "STREAM"
      ],
      "description": "Job 유형(v5.1, ADR-0015). 없으면 FULL. STREAM이면 실시간 창(stream-ingestor)이고 track-stitcher·pipeline-service는 건너뛴다."
    },
    "trackIdEpoch": {
      "type": "integer",
      "minimum": 0,
      "description": "실시간(STREAM) 트랙 ID 대역 번호(v5.1, SPEC-037 R-9). Ingestor가 임대를 이어받을 때 1 올린다. 업로드는 없다."
    },
    "jobId": {
      "type": "string",
      "format": "uuid"
    },
    "normalizationId": {
      "type": "string",
      "format": "uuid"
    },
    "origin": {
      "type": "string",
      "enum": [
        "chunk",
        "stitcher"
      ]
    },
    "chunkId": {
      "type": "string",
      "format": "uuid"
    },
    "executionId": {
      "type": "string",
      "format": "uuid"
    },
    "tracksKey": {
      "type": "string",
      "pattern": "^sources/[0-9a-f-]{36}/jobs/[0-9a-f-]{36}/chunks/[0-9a-f-]{36}/executions/[0-9a-f-]{36}/tracks[.]json$",
      "description": "origin chunk: 트랙 요약 파일"
    },
    "detectionsKey": {
      "type": "string",
      "pattern": "^sources/[0-9a-f-]{36}/jobs/[0-9a-f-]{36}/chunks/[0-9a-f-]{36}/executions/[0-9a-f-]{36}/detections[.]json$",
      "description": "origin chunk: analysis-loader가 적재하는 검출 박스 파일(소유 범위만, 1~2fps). 파일 형식은 생산자 spec에서 정한다"
    },
    "trackCount": {
      "type": "integer",
      "minimum": 0
    },
    "earlierChunkId": {
      "type": "string",
      "format": "uuid",
      "description": "origin stitcher: 앞 청크"
    },
    "laterChunkId": {
      "type": "string",
      "format": "uuid",
      "description": "origin stitcher: 뒤 청크(앞 청크 ownedRange.endMs = 뒤 청크 ownedRange.startMs)"
    },
    "stitched": {
      "type": "array",
      "maxItems": 1024,
      "description": "origin stitcher: 이 경계에서 이어진 트랙 묶음. 앞 청크에서 이미 이어진 구성원도 포함한다",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "trackId",
          "className",
          "startMs",
          "endMs",
          "members"
        ],
        "properties": {
          "trackId": {
            "type": "string",
            "format": "uuid",
            "description": "경계 연결 기준 트랙 ID. Re-ID로 다른 트랙과 합쳐지면 최종 ID는 track.manifest 번역표가 정한다"
          },
          "className": {
            "$ref": "../taxonomy/v2/taxonomy.schema.json#/$defs/className"
          },
          "startMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "endMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "members": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "chunkId",
                "executionId",
                "trackLocalId"
              ],
              "properties": {
                "chunkId": {
                  "type": "string",
                  "format": "uuid"
                },
                "executionId": {
                  "type": "string",
                  "format": "uuid"
                },
                "trackLocalId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,64}$"
                }
              }
            }
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "origin": {
          "const": "chunk"
        }
      },
      "required": [
        "chunkId",
        "executionId",
        "tracksKey",
        "detectionsKey",
        "trackCount"
      ]
    },
    {
      "properties": {
        "origin": {
          "const": "stitcher"
        }
      },
      "required": [
        "earlierChunkId",
        "laterChunkId",
        "stitched"
      ]
    }
  ],
  "examples": [
    {
      "eventId": "0192f100-0000-5000-8000-0000000000c1",
      "eventType": "track.detected",
      "schemaVersion": 1,
      "occurredAt": "2026-11-06T09:00:05Z",
      "sourceId": "0192f0d2-1a2b-7c3d-8e4f-5a6b7c8d9e0f",
      "ownerId": "0192f0c4-6d1e-7a3b-9c2d-1e2f3a4b5c6d",
      "jobId": "0192f100-0000-7000-8000-000000000001",
      "normalizationId": "0192f100-0000-7000-8000-000000000004",
      "origin": "chunk",
      "chunkId": "0192f100-0000-7000-8000-000000000002",
      "executionId": "0192f100-0000-7000-8000-000000000003",
      "tracksKey": "sources/0192f0d2-1a2b-7c3d-8e4f-5a6b7c8d9e0f/jobs/0192f100-0000-7000-8000-000000000001/chunks/0192f100-0000-7000-8000-000000000002/executions/0192f100-0000-7000-8000-000000000003/tracks.json",
      "detectionsKey": "sources/0192f0d2-1a2b-7c3d-8e4f-5a6b7c8d9e0f/jobs/0192f100-0000-7000-8000-000000000001/chunks/0192f100-0000-7000-8000-000000000002/executions/0192f100-0000-7000-8000-000000000003/detections.json",
      "trackCount": 12
    },
    {
      "eventId": "0192f100-0000-5000-8000-0000000000c2",
      "eventType": "track.detected",
      "schemaVersion": 1,
      "occurredAt": "2026-11-06T09:00:09Z",
      "sourceId": "0192f0d2-1a2b-7c3d-8e4f-5a6b7c8d9e0f",
      "ownerId": "0192f0c4-6d1e-7a3b-9c2d-1e2f3a4b5c6d",
      "jobId": "0192f100-0000-7000-8000-000000000001",
      "normalizationId": "0192f100-0000-7000-8000-000000000004",
      "origin": "stitcher",
      "earlierChunkId": "0192f100-0000-7000-8000-000000000002",
      "laterChunkId": "0192f100-0000-7000-8000-000000000012",
      "stitched": [
        {
          "trackId": "0192f100-0000-5000-8000-0000000000e1",
          "className": "person",
          "startMs": 101000,
          "endMs": 190000,
          "members": [
            {
              "chunkId": "0192f100-0000-7000-8000-000000000002",
              "executionId": "0192f100-0000-7000-8000-000000000003",
              "trackLocalId": "t7"
            },
            {
              "chunkId": "0192f100-0000-7000-8000-000000000012",
              "executionId": "0192f100-0000-7000-8000-000000000013",
              "trackLocalId": "t2"
            }
          ]
        }
      ]
    }
  ]
}
