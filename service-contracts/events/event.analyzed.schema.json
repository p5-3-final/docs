{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vlm.example/contracts/events/event.analyzed.schema.json",
  "title": "EventAnalyzed",
  "description": "이벤트 후보 하나를 판정했다. 후보마다 한 번 발행한다(같은 후보면 같은 eventId). 모델 미설정·예산 초과(unverified)와 판정 실패(unknown)도 버리지 않고 발행한다. 소비자는 eventId로 중복을 흡수한다. 벡터 후보(SPEC-020)와 탐지기·규칙 후보(SPEC-023)를 같은 형식으로 낸다. 발행: event-analyzer. 소비: analysis-api, embedding-worker, quality-service (SPEC-020 R-8~R-10)",
  "type": "object",
  "allOf": [
    {
      "$ref": "_envelope.schema.json"
    },
    {
      "if": {
        "properties": {
          "judgmentMethod": {
            "enum": [
              "vector+vlm",
              "vector+vlm+escalate"
            ]
          }
        }
      },
      "then": {
        "required": [
          "vectorCandidate"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "judgmentMethod": {
            "enum": [
              "rule",
              "rule+vlm",
              "rule+vlm+escalate"
            ]
          }
        }
      },
      "then": {
        "required": [
          "detectorCandidate"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "judgmentMethod": {
            "not": {
              "const": "rule"
            }
          }
        }
      },
      "then": {
        "properties": {
          "judgments": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "judgmentMethod": {
            "const": "rule"
          }
        }
      },
      "then": {
        "properties": {
          "judgments": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "required": [
    "jobId",
    "chunkId",
    "executionId",
    "normalizationId",
    "candidateId",
    "candidateEventType",
    "startMs",
    "endMs",
    "evidenceFrameKeys",
    "judgmentMethod",
    "analysis",
    "judgments",
    "reviewRequired",
    "reviewReasons",
    "taxonomyVersion"
  ],
  "properties": {
    "eventType": {
      "const": "event.analyzed"
    },
    "schemaVersion": {
      "const": 1
    },
    "jobId": {
      "type": "string",
      "format": "uuid"
    },
    "chunkId": {
      "type": "string",
      "format": "uuid"
    },
    "executionId": {
      "type": "string",
      "format": "uuid"
    },
    "normalizationId": {
      "type": "string",
      "format": "uuid"
    },
    "candidateId": {
      "type": "string",
      "format": "uuid",
      "description": "판정한 후보의 ID. eventId는 이 값으로 결정적으로 만든다."
    },
    "candidateEventType": {
      "$ref": "../taxonomy/v2/taxonomy.schema.json#/$defs/detectableEventType",
      "description": "후보의 유형. 판정 결과의 유형은 analysis.eventType이다."
    },
    "startMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807,
      "description": "후보 시작 시각. 정규화 사본 기준 밀리초"
    },
    "endMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807,
      "description": "후보 끝 시각. 정규화 사본 기준 밀리초"
    },
    "evidenceFrameKeys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "string",
        "pattern": "^sources/[0-9a-f-]{36}/jobs/[0-9a-f-]{36}/chunks/[0-9a-f-]{36}/executions/[0-9a-f-]{36}/blurred/[^/?#]+\\.(jpg|jpeg|png|webp)$"
      },
      "description": "판정에 보낸 근거 프레임(블러 사본) 경로. 보낸 순서다."
    },
    "judgmentMethod": {
      "type": "string",
      "enum": [
        "rule",
        "rule+vlm",
        "rule+vlm+escalate",
        "vector+vlm",
        "vector+vlm+escalate"
      ],
      "description": "rule: 규칙으로 확정(VLM 없음, 템플릿 결과), rule+vlm·vector+vlm: event_judge 한 번, …+escalate: event_judge_escalate 재판정까지 부른 것. rule로 시작하면 탐지기·규칙 후보(event.candidate, SPEC-023), vector로 시작하면 벡터 후보(event.candidate.vector, SPEC-020)다."
    },
    "vectorCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segmentId",
        "score",
        "threshold",
        "prototypeVersion",
        "embeddingModel"
      ],
      "description": "벡터 후보(event.candidate.vector)의 근거. judgmentMethod가 vector로 시작하면 있다.",
      "properties": {
        "segmentId": {
          "type": "string",
          "format": "uuid"
        },
        "score": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "threshold": {
          "type": "number",
          "exclusiveMinimum": -1,
          "maximum": 1
        },
        "prototypeVersion": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,99}$"
        },
        "embeddingModel": {
          "type": "string",
          "pattern": "^[^:\\s]+:[^:\\s]+:[^:\\s]+:[^:\\s]+$",
          "description": "인코더 모델 ID `<라이브러리>:<아키텍처>:<가중치>:<집계>`"
        }
      }
    },
    "analysis": {
      "$ref": "_vlm-analysis.schema.json",
      "description": "최종 판정. 재판정이 confirmed·rejected면 재판정 결과, 아니면 1차 결과다(SPEC-020 R-5)."
    },
    "judgments": {
      "type": "array",
      "minItems": 0,
      "maxItems": 2,
      "description": "판정 호출 기록. 1차(judge)가 먼저, 재판정(escalate)이 있으면 그 뒤다. 판정 방식 rule이면 호출이 없어 빈 배열이다.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stage",
          "taskType",
          "callId",
          "modelId",
          "promptVersion",
          "verificationStatus",
          "errorCode"
        ],
        "properties": {
          "stage": {
            "type": "string",
            "enum": [
              "judge",
              "escalate"
            ]
          },
          "taskType": {
            "type": "string",
            "enum": [
              "event_judge",
              "event_judge_escalate"
            ]
          },
          "callId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "ai-gateway 호출 ID. 호출이 끝내 실패하면 null"
          },
          "modelId": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200,
            "description": "ai-gateway가 부른 모델. 모델 미설정·예산 초과·호출 실패면 null"
          },
          "promptVersion": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200,
            "description": "프롬프트 버전 ID. 호출 실패면 null"
          },
          "verificationStatus": {
            "type": "string",
            "enum": [
              "confirmed",
              "rejected",
              "unverified",
              "unknown"
            ]
          },
          "errorCode": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[A-Z][A-Z0-9_]{1,63}$",
            "description": "호출이 끝내 실패했을 때의 오류 코드(ai-gateway 오류 코드, 또는 AI_TIMEOUT·AI_CONNECTION_FAILED). 성공이면 null"
          }
        }
      }
    },
    "reviewRequired": {
      "type": "boolean",
      "description": "사람이 검토해야 하는지. quality-service가 검토 큐에 넣는다."
    },
    "reviewReasons": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "judgment_disagreement"
        ]
      },
      "description": "judgment_disagreement: 1차와 재판정이 confirmed·rejected로 엇갈림. reviewRequired가 false면 빈 배열"
    },
    "taxonomyVersion": {
      "const": "v2"
    },
    "detectorCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chunkId",
        "executionId",
        "triggerClass",
        "score",
        "observationCount",
        "trackLocalId",
        "zoneId",
        "zoneName",
        "detectorProfile",
        "mergedCandidateIds"
      ],
      "description": "탐지기·규칙 후보(event.candidate)의 근거. judgmentMethod가 rule로 시작하면 있다(SPEC-023 R-10).",
      "properties": {
        "chunkId": {
          "type": "string",
          "format": "uuid"
        },
        "executionId": {
          "type": "string",
          "format": "uuid"
        },
        "triggerClass": {
          "$ref": "../taxonomy/v2/taxonomy.schema.json#/$defs/className"
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "observationCount": {
          "type": "integer",
          "minimum": 1
        },
        "trackLocalId": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "description": "관련 로컬 트랙. 최종 trackId는 track.manifest 번역표로 analysis-api가 정한다"
        },
        "zoneId": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "zoneName": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        },
        "detectorProfile": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,99}$"
        },
        "mergedCandidateIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "description": "쿨다운 병합으로 이 후보에 합쳐진 다른 후보 ID(SPEC-023 R-3). 없으면 빈 배열"
        }
      }
    }
  },
