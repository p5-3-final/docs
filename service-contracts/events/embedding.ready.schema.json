{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vlm.example/contracts/events/embedding.ready.schema.json",
  "title": "EmbeddingReady",
  "description": "텍스트 항목 하나의 텍스트 벡터 파일 저장 완료. 항목마다 한 번 발행한다(같은 항목·같은 임베딩 모델이면 같은 eventId). 발행: embedding-worker. 소비: search-service (SPEC-025)",
  "type": "object",
  "allOf": [
    {
      "$ref": "_envelope.schema.json"
    }
  ],
  "required": [
    "jobId",
    "itemKind",
    "itemId",
    "vectorKey",
    "textFormat",
    "embeddingModel",
    "dimension"
  ],
  "properties": {
    "eventType": {
      "const": "embedding.ready"
    },
    "schemaVersion": {
      "const": 1
    },
    "jobId": {
      "type": "string",
      "format": "uuid"
    },
    "itemKind": {
      "type": "string",
      "enum": [
        "event",
        "track",
        "segment_annotation"
      ],
      "description": "event: event.analyzed 설명문·위험 사유·조치 제안, track: 트랙 속성 설명, segment_annotation: 정밀 검색 구간 주석"
    },
    "itemId": {
      "type": "string",
      "format": "uuid"
    },
    "vectorKey": {
      "type": "string",
      "pattern": "^sources/[0-9a-f-]{36}/jobs/[0-9a-f-]{36}/text-vectors/(event|track|segment_annotation)/[0-9a-f-]{36}[.]json$",
      "description": "텍스트 벡터 파일(vectors/v1/text-vector-file.schema.json)"
    },
    "textFormat": {
      "type": "string",
      "pattern": "^[a-z0-9_]+-v[0-9]+$"
    },
    "embeddingModel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "ai-gateway embed_text 응답의 modelId(프로필의 텍스트 임베딩 모델)"
    },
    "dimension": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    }
  },
  "examples": [
    {
      "eventId": "0192f100-0000-5000-8000-000000000e51",
      "eventType": "embedding.ready",
      "schemaVersion": 1,
      "occurredAt": "2026-11-06T09:20:00Z",
      "sourceId": "0192f0d2-1a2b-7c3d-8e4f-5a6b7c8d9e0f",
      "ownerId": "0192f0c4-6d1e-7a3b-9c2d-1e2f3a4b5c6d",
      "jobId": "0192f100-0000-7000-8000-000000000001",
      "itemKind": "event",
      "itemId": "0192f100-0000-5000-8000-0000000000f1",
      "vectorKey": "sources/0192f0d2-1a2b-7c3d-8e4f-5a6b7c8d9e0f/jobs/0192f100-0000-7000-8000-000000000001/text-vectors/event/0192f100-0000-5000-8000-0000000000f1.json",
      "textFormat": "event-v1",
      "embeddingModel": "text-embedding-3-small",
      "dimension": 1536
    }
  ]
}
