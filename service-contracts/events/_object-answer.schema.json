{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vlm.example/contracts/events/_object-answer.schema.json",
  "title": "ObjectAnswer",
  "description": "객체 자유 질문의 답. ai-gateway object_question의 출력이고 track.analyzed의 answer로 전달된다 (SPEC-024)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verificationStatus",
    "answerable",
    "answer"
  ],
  "properties": {
    "verificationStatus": {
      "type": "string",
      "enum": [
        "confirmed",
        "unverified",
        "unknown"
      ]
    },
    "answerable": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "이미지만으로 답할 수 있었는지. null이면 ai-gateway가 만든 결과"
    },
    "answer": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1000,
      "description": "한국어 답. 신원·추측은 쓰지 않는다. 답할 수 없으면 이유"
    }
  },
  "examples": [
    {
      "verificationStatus": "confirmed",
      "answerable": true,
      "answer": "오른손에 무전기를 들고 있습니다."
    },
    {
      "verificationStatus": "unknown",
      "answerable": null,
      "answer": null
    }
  ]
}
