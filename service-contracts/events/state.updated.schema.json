{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vlm.example/contracts/events/state.updated.schema.json",
  "title": "StateUpdated",
  "description": "실시간 창 하나의 증분 fold 결과(v5.1, ADR-0016). 창마다 1건, sequence는 창 순번이다(eventId는 jobId·sequence로 결정적). 바뀐 것만 싣고 전체 상태는 싣지 않는다. 소비자는 sequence가 저장된 값보다 클 때만 적용한다. 발행: aggregator (SPEC-027 R-30). 소비: stream-service (SPEC-036 R-16), notification-service(생산자 확인 필요)",
  "type": "object",
  "allOf": [
    {
      "$ref": "_envelope.schema.json"
    }
  ],
  "required": [
    "jobId",
    "jobType",
    "chunkId",
    "sequence",
    "windowStartMs",
    "windowEndMs",
    "partial",
    "gapMs",
    "snapshots",
    "riskTransitions",
    "ruleEvents",
    "exposureDeltas",
    "activeRiskZoneIds",
    "counts",
    "aggregateProfile",
    "taxonomyVersion"
  ],
  "properties": {
    "eventType": {
      "const": "state.updated"
    },
    "schemaVersion": {
      "const": 1
    },
    "jobId": {
      "type": "string",
      "format": "uuid"
    },
    "jobType": {
      "const": "STREAM"
    },
    "chunkId": {
      "type": "string",
      "format": "uuid"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "windowStartMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "windowEndMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "partial": {
      "type": "boolean",
      "description": "개수 대조 상한 뒤 빠진 이벤트가 있는 채로 fold함(SPEC-027 R-30)"
    },
    "gapMs": {
      "type": "integer",
      "minimum": 0,
      "description": "직전 창과의 빈 시간(Pod 재시작·RTSP 끊김). 없으면 0"
    },
    "snapshots": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "snapshotId",
          "zoneId",
          "timestampMs",
          "previousState",
          "currentState",
          "relatedEventId"
        ],
        "properties": {
          "snapshotId": {
            "type": "string",
            "format": "uuid"
          },
          "zoneId": {
            "type": "string",
            "description": "구역 ID 또는 global"
          },
          "timestampMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "previousState": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 500
          },
          "currentState": {
            "type": "string",
            "maxLength": 500
          },
          "relatedEventId": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    },
    "riskTransitions": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "riskId",
          "zoneId",
          "riskType",
          "transition",
          "timestampMs",
          "reason",
          "relatedEventIds"
        ],
        "properties": {
          "riskId": {
            "type": "string",
            "format": "uuid"
          },
          "zoneId": {
            "type": "string"
          },
          "riskType": {
            "type": "string",
            "maxLength": 64
          },
          "transition": {
            "type": "string",
            "enum": [
              "activated",
              "updated",
              "resolved"
            ]
          },
          "timestampMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "reason": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 500
          },
          "relatedEventIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      }
    },
    "ruleEvents": {
      "type": "array",
      "maxItems": 500,
      "description": "이 창에서 만든 규칙 이벤트(체류·배회·장비 방치 등). 형식은 결과 파일 ruleEvents 항목과 같다",
      "items": {
        "$ref": "../aggregates/v1/source-result.schema.json#/properties/ruleEvents/items"
      }
    },
    "exposureDeltas": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "riskId",
          "activeSecondsDelta",
          "exposureCountDelta",
          "exposureSecondsDelta"
        ],
        "properties": {
          "riskId": {
            "type": "string",
            "format": "uuid"
          },
          "activeSecondsDelta": {
            "type": "number",
            "minimum": 0
          },
          "exposureCountDelta": {
            "type": "integer",
            "minimum": 0
          },
          "exposureSecondsDelta": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "activeRiskZoneIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      },
      "description": "이 창 뒤 활성 위험이 있는 구역 ID 전체. stream-service가 Redis 세션 키에 그대로 쓴다(SPEC-036 R-17)"
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputEvents",
        "confirmedEvents",
        "activeRisks"
      ],
      "properties": {
        "inputEvents": {
          "type": "integer",
          "minimum": 0
        },
        "confirmedEvents": {
          "type": "integer",
          "minimum": 0
        },
        "activeRisks": {
          "type": "integer",
          "minimum": 0,
          "description": "이 창 뒤 활성 위험 수(전체)"
        }
      }
    },
    "aggregateProfile": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,99}$"
    },
    "taxonomyVersion": {
      "const": "v2"
    }
  },
  "examples": [
    {
      "eventId": "0192fb00-0000-5000-8000-000000000005",
      "eventType": "state.updated",
      "schemaVersion": 1,
      "occurredAt": "2026-11-06T10:05:25Z",
      "sourceId": "0192fb00-0000-7000-8000-000000000010",
      "ownerId": "0192f0c4-6d1e-7a3b-9c2d-1e2f3a4b5c6d",
      "jobId": "0192fb00-0000-7000-8000-000000000030",
      "jobType": "STREAM",
      "chunkId": "0192fb00-0000-5000-8000-00000000000f",
      "sequence": 16,
      "windowStartMs": 300000,
      "windowEndMs": 320000,
      "partial": false,
      "gapMs": 0,
      "snapshots": [
        {
          "snapshotId": "0192fb00-0000-5000-8000-0000000000e1",
          "zoneId": "global",
          "timestampMs": 302800,
          "previousState": null,
          "currentState": "작업자 쓰러짐",
          "relatedEventId": "0192fb00-0000-5000-8000-0000000000c1"
        }
      ],
      "riskTransitions": [
        {
          "riskId": "0192fb00-0000-5000-8000-0000000000d1",
          "zoneId": "global",
          "riskType": "fall",
          "transition": "activated",
          "timestampMs": 302800,
          "reason": "쓰러진 작업자",
          "relatedEventIds": [
            "0192fb00-0000-5000-8000-0000000000c1"
          ]
        }
      ],
      "ruleEvents": [],
      "exposureDeltas": [
        {
          "riskId": "0192fb00-0000-5000-8000-0000000000d1",
          "activeSecondsDelta": 17.2,
          "exposureCountDelta": 1,
          "exposureSecondsDelta": 17.2
        }
      ],
      "activeRiskZoneIds": [
        "global"
      ],
      "counts": {
        "inputEvents": 3,
        "confirmedEvents": 1,
        "activeRisks": 1
      },
      "aggregateProfile": "aggregate-v1",
      "taxonomyVersion": "v2"
    }
  ]
}
