{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vlm.example/contracts/groundings/v1/grounding-result.schema.json",
  "title": "GroundingResultFile",
  "description": "주석 구간 하나의 탐지 결과. 경로: sources/<sourceId>/groundings/<groundingId>/<groundingModel>/result.json. 작성: grounding-worker. 읽기: search-service, frontend(경로를 받아 표시) (SPEC-026)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sourceId",
    "groundingId",
    "segmentId",
    "startMs",
    "endMs",
    "targets",
    "groundingModel",
    "scoreThreshold",
    "sampleFps",
    "colors",
    "clip",
    "frames"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "sourceId": {
      "type": "string",
      "format": "uuid"
    },
    "groundingId": {
      "type": "string",
      "format": "uuid"
    },
    "segmentId": {
      "type": "string",
      "format": "uuid"
    },
    "startMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "endMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9 '-]{0,79}$",
        "description": "영어 소문자 명사구(ai-gateway /v1/parse의 시각 대상어). 예: person without a hard hat"
      },
      "description": "대상어 1~3개. 탐지기 텍스트 클래스로 쓴다"
    },
    "groundingModel": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$",
      "description": "grounding 탐지기 버전(가중치 manifest의 version). S3 경로 한 단계로 쓰므로 콜론·슬래시가 없다"
    },
    "scoreThreshold": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "남긴 탐지의 최소 신뢰도(프로필 값)"
    },
    "sampleFps": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 5,
      "description": "탐지를 돌린 샘플 간격(기본 1)"
    },
    "colors": {
      "type": "object",
      "description": "대상어별 박스 색(#rrggbb). 대상어의 sha256 앞 3바이트로 정해 같은 대상어는 항상 같은 색이다",
      "additionalProperties": {
        "type": "string",
        "pattern": "^#[0-9a-f]{6}$"
      }
    },
    "clip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "codec",
        "fps",
        "width",
        "height",
        "durationMs",
        "audio"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^sources/[0-9a-f-]{36}/groundings/[0-9a-f-]{36}/[A-Za-z0-9._-]{1,100}/clip[.]mp4$"
        },
        "codec": {
          "const": "h264"
        },
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 240
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "durationMs": {
          "type": "integer",
          "minimum": 1
        },
        "audio": {
          "type": "boolean",
          "description": "원본에 오디오가 있으면 그대로 넣는다"
        }
      }
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "description": "샘플 프레임. 시각 순",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ptsMs",
          "detections"
        ],
        "properties": {
          "ptsMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "detections": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "target",
                "box",
                "confidence"
              ],
              "properties": {
                "target": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9 '-]{0,79}$",
                  "description": "영어 소문자 명사구(ai-gateway /v1/parse의 시각 대상어). 예: person without a hard hat"
                },
                "box": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "x",
                    "y",
                    "w",
                    "h"
                  ],
                  "description": "프레임 크기로 나눈 0~1 좌표. 왼쪽 위 기준",
                  "properties": {
                    "x": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "y": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "w": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "h": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  }
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          }
        }
      }
    }
  },
  "examples": [
    {
      "schemaVersion": 1,
      "sourceId": "0192f0d2-1a2b-7c3d-8e4f-5a6b7c8d9e0f",
      "groundingId": "0192f300-0000-5000-8000-0000000000a1",
      "segmentId": "0192f0e0-0000-5000-8000-000000000011",
      "startMs": 40000,
      "endMs": 50000,
      "targets": [
        "person without a hard hat",
        "forklift"
      ],
      "groundingModel": "yoloe-v8s-seg-v1",
      "scoreThreshold": 0.25,
      "sampleFps": 1,
      "colors": {
        "person without a hard hat": "#3fa2c1",
        "forklift": "#d0571e"
      },
      "clip": {
        "key": "sources/0192f0d2-1a2b-7c3d-8e4f-5a6b7c8d9e0f/groundings/0192f300-0000-5000-8000-0000000000a1/yoloe-v8s-seg-v1/clip.mp4",
        "codec": "h264",
        "fps": 30,
        "width": 1920,
        "height": 1080,
        "durationMs": 10000,
        "audio": false
      },
      "frames": [
        {
          "ptsMs": 40000,
          "detections": [
            {
              "target": "person without a hard hat",
              "box": {
                "x": 0.41,
                "y": 0.22,
                "w": 0.08,
                "h": 0.31
              },
              "confidence": 0.62
            },
            {
              "target": "forklift",
              "box": {
                "x": 0.6,
                "y": 0.35,
                "w": 0.25,
                "h": 0.4
              },
              "confidence": 0.81
            }
          ]
        },
        {
          "ptsMs": 41000,
          "detections": []
        }
      ]
    }
  ]
}
