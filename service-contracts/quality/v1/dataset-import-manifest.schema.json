{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vlm.example/contracts/quality/v1/dataset-import-manifest.schema.json",
  "title": "DatasetImportManifest",
  "description": "외부 데이터셋 가져오기 입력. 운영자가 가져오기 버킷의 imports/<폴더>/manifest.json에 영상과 함께 올린다. 영상 경로는 매니페스트 폴더 기준 상대 경로다. 읽기: quality-service (SPEC-030)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "datasetName",
    "origin",
    "taxonomyVersion",
    "videos"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "datasetName": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,50}$",
      "description": "Golden Set 이름 접두사. <이름>-dev, <이름>-eval 두 Golden Set에 들어간다"
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "license",
        "url"
      ],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "license": {
          "type": "string",
          "maxLength": 200,
          "description": "사용 허락 조건(예: CC BY 4.0). 평가 결과에 출처로 남긴다"
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        }
      }
    },
    "taxonomyVersion": {
      "type": "string",
      "pattern": "^v[0-9]+$"
    },
    "videos": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "externalId",
          "path",
          "contentType",
          "labels"
        ],
        "properties": {
          "externalId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,128}$",
            "description": "원본 데이터셋의 영상 ID. 데이터셋 안에서 유일하다"
          },
          "path": {
            "type": "string",
            "pattern": "^videos/(?!.*[.][.])[A-Za-z0-9._/-]{1,400}[.](mp4|mov|mkv|webm|avi)$",
            "description": "매니페스트 폴더 기준 상대 경로. `..`를 쓸 수 없다"
          },
          "contentType": {
            "type": "string",
            "enum": [
              "video/mp4",
              "video/quicktime",
              "video/x-matroska",
              "video/webm",
              "video/x-msvideo"
            ]
          },
          "labels": {
            "type": "array",
            "maxItems": 100000,
            "items": {
              "$ref": "#/$defs/label"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "bboxLabel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ptsMs",
        "className",
        "box"
      ],
      "properties": {
        "kind": {
          "const": "bbox"
        },
        "ptsMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "className": {
          "$ref": "../../taxonomy/v2/taxonomy.schema.json#/$defs/className"
        },
        "box": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y",
            "w",
            "h"
          ],
          "description": "프레임 크기로 나눈 0~1 좌표, 왼쪽 위 기준",
          "properties": {
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "w": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "h": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "trackExternalId": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64,
          "description": "같은 객체를 프레임 사이에 잇는 원본 데이터셋의 ID"
        }
      }
    },
    "intervalLabel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "eventType",
        "startMs",
        "endMs"
      ],
      "properties": {
        "kind": {
          "const": "interval"
        },
        "eventType": {
          "$ref": "../../taxonomy/v2/taxonomy.schema.json#/$defs/eventType"
        },
        "startMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "endMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "severity": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "low",
            "medium",
            "high",
            null
          ]
        }
      }
    },
    "stateChangeLabel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "atMs",
        "className",
        "change"
      ],
      "properties": {
        "kind": {
          "const": "state_change"
        },
        "atMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "className": {
          "$ref": "../../taxonomy/v2/taxonomy.schema.json#/$defs/className"
        },
        "change": {
          "type": "string",
          "enum": [
            "removed",
            "moved",
            "added",
            "restored"
          ]
        },
        "zoneName": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        }
      }
    },
    "label": {
      "oneOf": [
        {
          "$ref": "#/$defs/bboxLabel"
        },
        {
          "$ref": "#/$defs/intervalLabel"
        },
        {
          "$ref": "#/$defs/stateChangeLabel"
        }
      ]
    }
  },
  "examples": [
    {
      "schemaVersion": 1,
      "datasetName": "physicalai-events",
      "origin": {
        "name": "PhysicalAI-Event-Videos",
        "license": "CC BY 4.0",
        "url": null
      },
      "taxonomyVersion": "v2",
      "videos": [
        {
          "externalId": "clip-0001",
          "path": "videos/clip-0001.mp4",
          "contentType": "video/mp4",
          "labels": [
            {
              "kind": "interval",
              "eventType": "ppe_missing",
              "startMs": 12000,
              "endMs": 20000,
              "severity": "medium"
            },
            {
              "kind": "bbox",
              "ptsMs": 15000,
              "className": "no_helmet",
              "box": {
                "x": 0.4,
                "y": 0.2,
                "w": 0.06,
                "h": 0.1
              },
              "trackExternalId": "p1"
            },
            {
              "kind": "state_change",
              "atMs": 30000,
              "className": "safety_barrier",
              "change": "removed",
              "zoneName": null
            }
          ]
        }
      ]
    }
  ]
}
