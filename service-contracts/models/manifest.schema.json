{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vlm.example/contracts/models/manifest.schema.json",
  "title": "Model artifact manifest",
  "description": "모델 산출물 manifest(ADR-0010 ②). 모델 저장소 models/<종류>/<버전>/manifest.json에 두고, 같은 폴더의 파일을 체크섬으로 고정한다. 프로필은 manifest 경로와 manifest 파일의 SHA-256을 가리키고, 서비스는 manifest와 파일을 받아 체크섬을 확인한 뒤에만 /ready를 연다. 한 번 올린 버전 폴더는 덮어쓰거나 지우지 않는다.",
  "type": "object",
  "required": ["kind", "modelId", "version", "files", "source", "license"],
  "additionalProperties": false,
  "properties": {
    "kind": {
      "description": "모델 역할. image_text_encoder(이미지·질의 인코더), detector(탐지기), predictor(예측 모델)",
      "enum": ["image_text_encoder", "detector", "predictor"]
    },
    "modelId": {
      "description": "가중치를 가리키는 ID(<라이브러리>:<아키텍처>:<가중치>). 결과에 남기는 모델 ID는 이 값으로 시작한다(예: 인코더 open_clip:MobileCLIP2-S0:dfndr2b에 집계 :mean-4를 붙인다).",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(:[A-Za-z0-9][A-Za-z0-9._-]*){2}$",
      "maxLength": 128
    },
    "version": {
      "description": "manifest 경로의 <버전>과 같은 값",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "maxLength": 64
    },
    "files": {
      "description": "manifest와 같은 폴더에 있는 파일. 서비스는 이 목록의 파일만 받는다.",
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/file"}
    },
    "dimension": {
      "description": "출력 벡터 차원. image_text_encoder는 필수다.",
      "type": "integer",
      "minimum": 1
    },
    "classes": {
      "description": "탐지기가 내는 클래스. 고정 클래스 탐지기(openVocabulary가 없거나 false)는 필수다.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "../taxonomy/v2/taxonomy.schema.json#/$defs/className"}
    },
    "openVocabulary": {
      "description": "detector 전용. true면 실행할 때 받은 대상어(문장)를 클래스로 쓰는 개방 어휘 탐지기라 고정 클래스가 없다(예: grounding-worker의 OWLv2, SPEC-026). 이때 classes를 생략한다.",
      "type": "boolean"
    },
    "source": {"$ref": "#/$defs/source"},
    "license": {
      "description": "가중치 라이선스와 사용 제한(예: Apple AMLR, 비상용)",
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    }
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "image_text_encoder"}}},
      "then": {"required": ["dimension"]}
    },
    {
      "if": {
        "properties": {"kind": {"const": "detector"}, "openVocabulary": {"const": true}},
        "required": ["openVocabulary"]
      },
      "then": {"not": {"required": ["classes"]}}
    },
    {
      "if": {
        "properties": {"kind": {"const": "detector"}},
        "not": {"properties": {"openVocabulary": {"const": true}}, "required": ["openVocabulary"]}
      },
      "then": {"required": ["classes"]}
    },
    {
      "if": {"not": {"properties": {"kind": {"const": "detector"}}}},
      "then": {"not": {"required": ["openVocabulary"]}}
    }
  ],
  "$defs": {
    "file": {
      "type": "object",
      "required": ["name", "sha256", "size"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "manifest 폴더 안의 파일 이름(하위 폴더 없음)",
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "maxLength": 128
        },
        "sha256": {
          "description": "파일 SHA-256(소문자 16진수)",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size": {
          "description": "파일 크기(바이트)",
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "source": {
      "description": "가중치 출처. public은 공개 가중치를 그대로 쓴 것, trained는 팀이 학습·파인튜닝한 것이다.",
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "origin"],
          "additionalProperties": false,
          "properties": {
            "type": {"const": "public"},
            "origin": {
              "description": "받은 곳(예: huggingface:timm/MobileCLIP2-S0-OpenCLIP)",
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        },
        {
          "type": "object",
          "required": ["type", "dataset"],
          "additionalProperties": false,
          "properties": {
            "type": {"const": "trained"},
            "dataset": {"type": "string", "minLength": 1, "maxLength": 128},
            "runId": {"type": "string", "minLength": 1, "maxLength": 128},
            "baseModelId": {
              "description": "파인튜닝했으면 시작한 모델의 modelId",
              "type": "string",
              "maxLength": 128
            }
          }
        }
      ]
    }
  }
}
