{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vlm.example/contracts/taxonomy/v2/class-mapping.schema.json",
  "title": "Class mapping v2",
  "description": "외부 데이터셋 라벨 ↔ 트리거 클래스 ↔ 이벤트 유형 대응표(ADR-0010 ①). 외부 데이터셋 라벨을 Golden Set 라벨로 바꿀 때와 탐지기 평가에서 쓴다. 내용은 AI 담당자가 채우고, 이 스키마는 형식과 버전만 정한다.",
  "type": "object",
  "required": ["taxonomyVersion", "version", "entries"],
  "additionalProperties": false,
  "properties": {
    "taxonomyVersion": {"const": "v2", "description": "이 대응표가 따르는 분류 체계 버전"},
    "version": {
      "description": "대응표 자체의 버전. 항목을 바꿀 때마다 올린다. 평가 실행 기록에 남긴다.",
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "entries": {
      "type": "array",
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": ["dataset", "datasetLabel", "triggerClass", "eventType"],
      "additionalProperties": false,
      "properties": {
        "dataset": {
          "description": "외부 데이터셋 식별자(예: construction-safety). Quality 데이터셋 가져오기의 이름과 같다.",
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "maxLength": 64
        },
        "datasetLabel": {
          "description": "데이터셋 원본 라벨 문자열(대소문자·공백 그대로)",
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "triggerClass": {
          "description": "이 라벨에 대응하는 탐지기 클래스·트리거 클래스",
          "$ref": "taxonomy.schema.json#/$defs/className"
        },
        "eventType": {
          "description": "이 클래스가 후보를 만드는 이벤트 유형. 이벤트와 무관한 객체 클래스(예: forklift)는 null",
          "anyOf": [{"$ref": "taxonomy.schema.json#/$defs/detectableEventType"}, {"type": "null"}]
        },
        "note": {"type": "string", "maxLength": 500}
      }
    }
  }
}
