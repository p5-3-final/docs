{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vlm.example/contracts/prompts/event_judge/output.schema.json",
  "title": "VLMAnalysis",
  "description": "event_judge 결과. 모델이 이 형식으로 답하고 ai-gateway가 검증한다. ai-gateway가 직접 만드는 결과(모델 미설정 unverified, 검증 실패 unknown)도 같은 형식이다(SPEC-009 R-5~R-8).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventType",
    "eventDetected",
    "verificationStatus",
    "description",
    "beforeState",
    "afterState",
    "riskDetected",
    "riskType",
    "riskReason",
    "solution",
    "severity",
    "evidenceStart",
    "evidenceEnd"
  ],
  "properties": {
    "eventType": {"$ref": "../../taxonomy/v2/taxonomy.schema.json#/$defs/eventType"},
    "eventDetected": {"type": ["boolean", "null"], "description": "null이면 판단할 수 없음"},
    "verificationStatus": {
      "type": "string",
      "enum": ["confirmed", "rejected", "unverified", "unknown"],
      "description": "unverified는 모델 미설정, unknown은 판단 불가 또는 출력 검증 실패"
    },
    "description": {"type": ["string", "null"], "maxLength": 1000, "description": "누가, 어디서, 무엇을 했는지 한두 문장. ai-gateway가 만든 결과는 null"},
    "beforeState": {"type": ["string", "null"], "maxLength": 500},
    "afterState": {"type": ["string", "null"], "maxLength": 500},
    "riskDetected": {"type": ["boolean", "null"]},
    "riskType": {"type": ["string", "null"], "maxLength": 100},
    "riskReason": {"type": ["string", "null"], "maxLength": 500},
    "solution": {"type": ["string", "null"], "maxLength": 500, "description": "조치 제안. 화면에는 \"안전관리자 확인 필요\"와 함께 보인다"},
    "severity": {
      "anyOf": [{"$ref": "../../taxonomy/v2/taxonomy.schema.json#/$defs/severity"}, {"type": "null"}],
      "description": "ai-gateway가 만든 결과는 null"
    },
    "evidenceStart": {"type": ["number", "null"], "minimum": 0, "description": "정규화 사본 기준 초"},
    "evidenceEnd": {"type": ["number", "null"], "minimum": 0, "description": "정규화 사본 기준 초"}
  },
  "if": {"properties": {"riskDetected": {"const": true}}, "required": ["riskDetected"]},
  "then": {"properties": {"riskType": {"type": "string"}, "riskReason": {"type": "string"}}},
  "examples": [
    {
      "eventType": "fall",
      "eventDetected": true,
      "verificationStatus": "confirmed",
      "description": "적재 구역에서 작업자 한 명이 지게차 옆에 넘어져 일어나지 못하고 있다.",
      "beforeState": "작업자가 지게차 옆을 걸어가고 있다.",
      "afterState": "작업자가 바닥에 누워 움직이지 않는다.",
      "riskDetected": true,
      "riskType": "worker_down",
      "riskReason": "쓰러진 작업자 옆에서 지게차가 계속 움직이고 있다.",
      "solution": "지게차 운행을 멈추고 작업자 상태를 확인한다.",
      "severity": "high",
      "evidenceStart": 62.0,
      "evidenceEnd": 65.5
    },
    {
      "eventType": "fall",
      "eventDetected": null,
      "verificationStatus": "unknown",
      "description": null,
      "beforeState": null,
      "afterState": null,
      "riskDetected": null,
      "riskType": null,
      "riskReason": null,
      "solution": null,
      "severity": null,
      "evidenceStart": null,
      "evidenceEnd": null
    }
  ]
}
