{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vlm.example/contracts/events/video.normalized.schema.json",
  "title": "VideoNormalized",
  "description": "영상 정규화가 끝났다. 결과가 READY면 정규화 사본·HLS 경로와 정규화 사본 PTS 기준 메타데이터를 싣고, REJECTED면 거절 사유를 싣는다. 해당하지 않는 필드는 null이다. 같은 영상을 다시 처리하면 같은 eventId로 다시 발행한다. 발행: normalize. 소비: media-service, pipeline-service (SPEC-007 R-6~R-12, R-14, R-16, R-17)",
  "type": "object",
  "required": [
    "result",
    "rejectReason",
    "normalizedKey",
    "hlsPlaylistKey",
    "durationSec",
    "fps",
    "width",
    "height",
    "transcoded"
  ],
  "properties": {
    "eventType": { "const": "video.normalized" },
    "schemaVersion": { "const": 1 },
    "result": {
      "type": "string",
      "enum": ["READY", "REJECTED"]
    },
    "rejectReason": {
      "type": ["string", "null"],
      "enum": ["UNREADABLE", "NO_VIDEO_STREAM", "MISSING_METADATA", "TOO_SHORT", "TOO_LONG", "DECODE_FAILED", null],
      "description": "REJECTED일 때 거절 사유. READY면 null"
    },
    "normalizedKey": {
      "type": ["string", "null"],
      "description": "정규화 사본(H.264 mp4)의 저장소 키. 영상 ID로만 만든다. 예: sources/<sourceId>/normalized/video.mp4"
    },
    "hlsPlaylistKey": {
      "type": ["string", "null"],
      "description": "HLS 재생 목록의 저장소 키. 조각은 같은 폴더에 있다. 예: sources/<sourceId>/normalized/hls/index.m3u8"
    },
    "durationSec": {
      "type": ["number", "null"],
      "exclusiveMinimum": 0,
      "description": "정규화 사본의 PTS 기준 길이(초). 이후 모든 시각의 기준이다"
    },
    "fps": {
      "type": ["number", "null"],
      "exclusiveMinimum": 0,
      "maximum": 240,
      "description": "정규화 사본의 고정 프레임률. 재인코딩했으면 30 이하다"
    },
    "width": { "type": ["integer", "null"], "minimum": 1 },
    "height": { "type": ["integer", "null"], "minimum": 1 },
    "transcoded": {
      "type": ["boolean", "null"],
      "description": "다시 인코딩했으면 true, 컨테이너만 바꿨으면 false"
    }
  },
  "allOf": [
    { "$ref": "_envelope.schema.json" },
    {
      "if": { "properties": { "result": { "const": "READY" } } },
      "then": {
        "properties": {
          "rejectReason": { "type": "null" },
          "normalizedKey": { "type": "string" },
          "hlsPlaylistKey": { "type": "string" },
          "durationSec": { "type": "number" },
          "fps": { "type": "number" },
          "width": { "type": "integer" },
          "height": { "type": "integer" },
          "transcoded": { "type": "boolean" }
        }
      },
      "else": {
        "properties": {
          "rejectReason": { "type": "string" },
          "normalizedKey": { "type": "null" },
          "hlsPlaylistKey": { "type": "null" },
          "durationSec": { "type": "null" },
          "fps": { "type": "null" },
          "width": { "type": "null" },
          "height": { "type": "null" },
          "transcoded": { "type": "null" }
        }
      }
    }
  ],
  "examples": [
    {
      "eventId": "9b1d7c1e-2f0a-5c4e-8d77-1f2e3a4b5c02",
      "eventType": "video.normalized",
      "schemaVersion": 1,
      "occurredAt": "2026-11-03T09:32:05Z",
      "sourceId": "0192f0d2-1a2b-7c3d-8e4f-5a6b7c8d9e0f",
      "ownerId": "0192f0c4-6d1e-7a3b-9c2d-1e2f3a4b5c6d",
      "result": "READY",
      "rejectReason": null,
      "normalizedKey": "sources/0192f0d2-1a2b-7c3d-8e4f-5a6b7c8d9e0f/normalized/video.mp4",
      "hlsPlaylistKey": "sources/0192f0d2-1a2b-7c3d-8e4f-5a6b7c8d9e0f/normalized/hls/index.m3u8",
      "durationSec": 612.48,
      "fps": 30,
      "width": 1920,
      "height": 1080,
      "transcoded": false
    },
    {
      "eventId": "9b1d7c1e-2f0a-5c4e-8d77-1f2e3a4b5c03",
      "eventType": "video.normalized",
      "schemaVersion": 1,
      "occurredAt": "2026-11-03T09:40:11Z",
      "sourceId": "0192f0d2-0000-7c3d-8e4f-5a6b7c8d9e10",
      "ownerId": "0192f0c4-6d1e-7a3b-9c2d-1e2f3a4b5c6d",
      "result": "REJECTED",
      "rejectReason": "NO_VIDEO_STREAM",
      "normalizedKey": null,
      "hlsPlaylistKey": null,
      "durationSec": null,
      "fps": null,
      "width": null,
      "height": null,
      "transcoded": null
    }
  ]
}
