{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vlm.example/contracts/events/video.normalized.v2.schema.json",
  "title": "VideoNormalizedV2",
  "description": "backend 소유 normalize 결과. READY만 Pipeline 계획 대상이며 REJECTED는 수신 사실만 기록한다. 같은 정규화 결과의 재전달은 eventId와 normalizationId를 유지한다.",
  "type": "object",
  "allOf": [
    {
      "$ref": "_envelope.schema.json"
    }
  ],
  "required": [
    "normalizationId",
    "normalizationVersion",
    "result",
    "rejectReason",
    "normalizedKey",
    "hlsPlaylistKey",
    "durationMs",
    "durationSec",
    "fps",
    "width",
    "height",
    "transcoded"
  ],
  "properties": {
    "eventType": {
      "const": "video.normalized"
    },
    "schemaVersion": {
      "const": 2
    },
    "normalizationId": {
      "type": "string",
      "format": "uuid",
      "description": "불변 정규화 결과 식별자. 재정규화하면 새 ID를 사용한다."
    },
    "normalizationVersion": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,99}$"
    },
    "result": {
      "enum": [
        "READY",
        "REJECTED"
      ]
    },
    "normalizedKey": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "hlsPlaylistKey": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "durationMs": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "durationSec": {
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0,
      "description": "호환용 초. READY에서는 durationMs / 1000과 정확히 같아야 한다."
    },
    "fps": {
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0,
      "maximum": 240
    },
    "width": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "height": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "transcoded": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "rejectReason": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "UNREADABLE",
        "NO_VIDEO_STREAM",
        "MISSING_METADATA",
        "TOO_SHORT",
        "TOO_LONG",
        "DECODE_FAILED"
      ]
    }
  },
  "oneOf": [
    {
      "properties": {
        "result": {
          "const": "READY"
        },
        "rejectReason": {
          "type": "null"
        },
        "normalizedKey": {
          "not": {
            "type": "null"
          }
        },
        "hlsPlaylistKey": {
          "not": {
            "type": "null"
          }
        },
        "durationMs": {
          "not": {
            "type": "null"
          }
        },
        "durationSec": {
          "not": {
            "type": "null"
          }
        },
        "fps": {
          "not": {
            "type": "null"
          }
        },
        "width": {
          "not": {
            "type": "null"
          }
        },
        "height": {
          "not": {
            "type": "null"
          }
        },
        "transcoded": {
          "not": {
            "type": "null"
          }
        }
      },
      "required": [
        "normalizedKey",
        "hlsPlaylistKey",
        "durationMs",
        "durationSec",
        "fps",
        "width",
        "height",
        "transcoded"
      ]
    },
    {
      "properties": {
        "result": {
          "const": "REJECTED"
        },
        "rejectReason": {
          "type": "string"
        },
        "normalizedKey": {
          "type": "null"
        },
        "hlsPlaylistKey": {
          "type": "null"
        },
        "durationMs": {
          "type": "null"
        },
        "durationSec": {
          "type": "null"
        },
        "fps": {
          "type": "null"
        },
        "width": {
          "type": "null"
        },
        "height": {
          "type": "null"
        },
        "transcoded": {
          "type": "null"
        }
      },
      "required": [
        "rejectReason"
      ]
    }
  ],
  "examples": [
    {
      "eventId": "0192f0d3-0000-7000-8000-000000000002",
      "eventType": "video.normalized",
      "schemaVersion": 2,
      "occurredAt": "2026-11-03T01:00:00Z",
      "sourceId": "0192f0d2-1a2b-7c3d-8e4f-5a6b7c8d9e0f",
      "ownerId": "0192f0c4-6d1e-7a3b-9c2d-1e2f3a4b5c6d",
      "normalizationId": "0192f0d4-0000-7000-8000-000000000001",
      "normalizationVersion": "normalize-v1",
      "result": "READY",
      "normalizedKey": "sources/0192f0d2-1a2b-7c3d-8e4f-5a6b7c8d9e0f/normalizations/0192f0d4-0000-7000-8000-000000000001/normalized.mp4",
      "hlsPlaylistKey": "sources/0192f0d2-1a2b-7c3d-8e4f-5a6b7c8d9e0f/normalizations/0192f0d4-0000-7000-8000-000000000001/hls/index.m3u8",
      "durationMs": 125001,
      "durationSec": 125.001,
      "fps": 30,
      "width": 1920,
      "height": 1080,
      "transcoded": false,
      "rejectReason": null
    },
    {
      "eventId": "0192f0d3-0000-7000-8000-000000000003",
      "eventType": "video.normalized",
      "schemaVersion": 2,
      "occurredAt": "2026-11-03T01:00:00Z",
      "sourceId": "0192f0d2-1a2b-7c3d-8e4f-5a6b7c8d9e0f",
      "ownerId": "0192f0c4-6d1e-7a3b-9c2d-1e2f3a4b5c6d",
      "normalizationId": "0192f0d4-0000-7000-8000-000000000002",
      "normalizationVersion": "normalize-v1",
      "result": "REJECTED",
      "normalizedKey": null,
      "hlsPlaylistKey": null,
      "durationMs": null,
      "durationSec": null,
      "fps": null,
      "width": null,
      "height": null,
      "transcoded": null,
      "rejectReason": "NO_VIDEO_STREAM"
    }
  ]
}
