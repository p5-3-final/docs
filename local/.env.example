# 로컬 compose(local/docker-compose.yml)가 읽는 값. cp local/.env.example local/.env 하면 샘플값으로 바로 뜬다. .env는 커밋하지 않는다.
# 서비스를 compose 없이 단독 실행할 때 쓰는 값은 각 레포의 .env.example에 있다.

# PostgreSQL 관리자 비밀번호. 로컬에서만 쓰는 샘플값
POSTGRES_PASSWORD=local-postgres-pw
# auth-service DB 계정 비밀번호. 로컬에서만 쓰는 샘플값
AUTH_DB_PASSWORD=local-auth-pw
# media-service DB 계정 비밀번호. 로컬에서만 쓰는 샘플값
MEDIA_DB_PASSWORD=local-media-pw
# ai-gateway DB 계정 비밀번호. 로컬에서만 쓰는 샘플값
AI_DB_PASSWORD=local-ai-pw
# 토큰 서명 키(개인키 포함 EC P-256 JWK JSON). repos/backend에서
#   ./gradlew -q :services:auth-service:generateSigningKey
# 출력을 작은따옴표로 감싸 넣는다. 새 키로 바꿔도 된다.
# 아래는 git에 공개된 로컬 전용 샘플 키다. 운영·공유 환경에서는 절대 쓰지 않는다(운영 키는 Secrets Manager).
AUTH_JWT_SIGNING_KEY='{"kty":"EC","d":"v_OXCdkCMfDjwpLAIAmEsR_V5pw6IIbFQiRwru8e0yQ","use":"sig","crv":"P-256","kid":"local-sample","x":"glBNFw9znWkVanHsx4GcfOOsVTR1DoQ3YxYMbMVCQM4","y":"hY6F69g9o3iPyc4RixkG5lKK8Xl73wDHEoHdrk-9qhE","alg":"ES256"}'
# 초기 관리자(선택). 비우면 만들지 않는다. 비밀번호는 8~64자, 영문과 숫자 포함
AUTH_ADMIN_EMAIL=admin@example.com
AUTH_ADMIN_PASSWORD=admin1234
# frontend 주소(개발 서버, frontend 컨테이너). 주소가 다르면 바꾼다. 쉼표로 구분한다.
GATEWAY_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Pipeline은 현재 이 compose에서 실행하지 않는다. 수신/배정/Outbox 설정 예제는
# repos/backend/.env.example을 참고한다. 운영 활성화나 Kafka offset 변경을 의미하지 않는다.
