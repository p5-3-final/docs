# 로컬 compose(local/docker-compose.yml)가 읽는 값. cp local/.env.example local/.env 후 채운다. .env는 커밋하지 않는다.
# 서비스를 compose 없이 단독 실행할 때 쓰는 값은 각 레포의 .env.example에 있다.

# PostgreSQL 관리자 비밀번호. 로컬에서만 쓰는 임의 값
POSTGRES_PASSWORD=
# auth-service DB 계정 비밀번호. 로컬에서만 쓰는 임의 값
AUTH_DB_PASSWORD=
# 토큰 서명 키(개인키 포함 EC P-256 JWK JSON). repos/backend에서
#   ./gradlew -q :services:auth-service:generateSigningKey
# 출력을 작은따옴표로 감싸 넣는다.
AUTH_JWT_SIGNING_KEY=
# 초기 관리자(선택). 비우면 만들지 않는다. 비밀번호는 8~64자, 영문과 숫자 포함
AUTH_ADMIN_EMAIL=
AUTH_ADMIN_PASSWORD=
# frontend 개발 서버 주소가 다르면 바꾼다.
GATEWAY_CORS_ALLOWED_ORIGINS=http://localhost:5173
