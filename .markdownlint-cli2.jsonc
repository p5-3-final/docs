// docs 레포 markdownlint 설정. 규칙은 .claude/rules/docs-writing.md "검사"를 따른다.
{
  "config": {
    // 한국어 문장, 표, 코드 블록은 줄이 길어질 수밖에 없어 줄 길이 제한을 끈다.
    "MD013": false,
    // spec·plan·ADR 템플릿은 frontmatter title과 # 제목을 함께 둔다. frontmatter title은 제목으로 세지 않는다.
    "MD025": { "front_matter_title": "" },
    // spec의 사용자 시나리오마다 "인수 조건" 소제목이 반복된다. 같은 상위 제목 안에서만 중복을 막는다.
    "MD024": { "siblings_only": true }
  }
}
